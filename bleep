#!/usr/bin/env bash
# bleep — 会社/private リポジトリの実名が PUBLIC な面(git push・
# gh pr/issue の create/edit/comment・任意テキスト)に漏れるのを防ぐための
# エージェント非依存の判定エンジン。
#
# これは security boundary ではない。制約される当事者(エージェント、または
# 手打ちする人間)が github.com に直接ブラウザで打ち込む経路はどう転んでも
# 仲介できないし、hook のタイムアウトや BLEEP_ALLOW=1 で無効化もできる。
# 事故とエージェントの滑りに対するガードレールとして使うこと。詳細は README。
#
# 判定は3段階(exit code で表現):
#   0 = pass  — denylist に一致しない
#   1 = ask   — denylist 上の org 名が裸の単語で単体出現(メールドメイン等の
#               正当な用途と衝突しうるため deny にしない)
#   2 = deny  — "org/repo" 形式(URL も含む)、または denylist に登録された
#               具体的なリポジトリ名の裸の単語一致(ほぼ確実に意図しない漏洩)
# ask/deny では stdout に理由を1行印字する。pass では何も印字しない。
#
# denylist は一切コミットしない(「ツールは公開・データはローカル」原則):
#   $XDG_CONFIG_HOME/bleep/orgs.txt   — 1行1 org 名(手書きが必要なのは
#                                               実質これだけ)。ファイル自体の
#                                               存在が必須 — 無ければ scan* は
#                                               ask(require_orgs_file)。空
#                                               ファイルは明示的な opt-out。
#   $XDG_CONFIG_HOME/bleep/repos.txt  — 1行1 "org/repo"(任意)
#   自分の private/internal リポジトリ名は、orgs.txt に書いた org 名 +
#   (BLEEP_OWNER が空なら `gh api user` で自動導出する)現在の
#   gh 認証ユーザから、各自の credential で live 導出して TTL 付きで
#   キャッシュする。リポジトリ名のリストそのものは誰も持ち運ばない。
#
# 誤検知の受け皿(gitleaks の [[allowlists]] と同型の3軸):
#   $XDG_CONFIG_HOME/bleep/allow-stopwords.txt — 単語単位で denylist
#     から除外する(組み込みで ".github" を既定値として持つ — GitHub の
#     org-wide デフォルト用の特殊リポジトリで、ファイルパスや URL の断片
#     としてどこにでも出現するため)。
#   $XDG_CONFIG_HOME/bleep/allow-regexes.txt   — この正規表現が
#     scan 対象テキストにマッチしたら ask 判定だけを無効化する(deny は
#     無効化しない — 「ほぼ確実に意図しない漏洩」の強さを緩めないため)。
#   $XDG_CONFIG_HOME/bleep/allow-paths.txt      — audit 対象から
#     除外するファイルパスの正規表現。
#
# 縮退(ADR-0005 の binary-existence gating に倣う): fail-loud に寄せている。
# 判定不能を無言の pass にはしない(下記の各関数のコメント参照)。ただし
# hook のタイムアウトで停止した場合はこのプロセス自体が動かないため防げない
# — これは構造的な限界であり README に明記する。
#
# 使い方:
#   bleep scan [FILE]              stdin(既定)または FILE の内容を
#                                           そのまま denylist と突き合わせる。
#                                           MCP tool_input 等、任意のテキスト向け。
#   bleep scan-push --pre-push REMOTE-NAME REMOTE-URL
#                                           git の pre-push hook(hooks/pre-push)
#                                           から呼ぶ。stdin の
#                                           `<local-ref> <local-sha> <remote-ref>
#                                           <remote-sha>` から、これから push
#                                           する各コミットの追加行(+ 新規/rename
#                                           先ファイルパス)と commit log を検査
#                                           する。削除行は対象外(#7)。対象
#                                           リポジトリ(remote の URL)が
#                                           PRIVATE/INTERNAL と判明していれば
#                                           検査自体をスキップする。deny/ask の
#                                           理由文に、一致した commit の短い
#                                           SHA を出す(#67)。ADR-0003。
#   bleep scan-push                引数なし。cwd の default branch との
#                                           merge-base..HEAD を検査する従来の
#                                           互換経路(新規ブランチ・shallow clone
#                                           では範囲を求められず ask になる)。
#   bleep scan-bash-command CMD     シェルコマンド文字列を検査する。
#                                           CMD を ; && || | 改行で区切った
#                                           セグメントごとに、global option
#                                           (git の -C 等、gh の --repo 等)を
#                                           読み飛ばしてサブコマンド位置を見る
#                                           (#9/#14 — 正規表現の隣接一致では
#                                           "git -C dir push"/"gh --repo x pr
#                                           create" を取りこぼしていた)。
#                                           gh の投稿("gh pr|issue create/
#                                           edit/comment/review/close/merge/
#                                           reopen" "gh release create/edit"
#                                           "gh repo edit" "gh gist create"
#                                           "gh api -X POST/PUT/PATCH" など、
#                                           自由記述を公開面へ運ぶ既知のコマンド)
#                                           は、正準形(-R OWNER/REPO + 絶対
#                                           パスの --body-file)だけを受理し、
#                                           外れた形は deny する(ADR-0003)。
#                                           正準形なら、CMD 全文から
#                                           "cd <単一トークン>" セグメント
#                                           だけを除いたテキストと本文ファイルを
#                                           検査する(#9 — cd のパス引数に
#                                           private リポ名が含まれるだけでは
#                                           deny しない)。宛先がリテラルの
#                                           PRIVATE/INTERNAL なら検査しない。
#                                           "git push" は中身を検査せず
#                                           (pre-push が検査する、ADR-0003)、
#                                           pre-push を無効にする形
#                                           (--no-verify、-c core.hooksPath=)
#                                           だけを deny する。どちらの形も無ければ
#                                           無検査で pass。
#   bleep audit [path...] [--remote] [--since REV]
#                                           指定ファイル(省略時は git ls-files
#                                           全体)を同じ denylist で検査する。
#                                           --remote で open な Issue/PR の
#                                           title/body も対象に含める。
#                                           --since REV で "REV..HEAD" の
#                                           追加行/新規ファイルパス/commit
#                                           メッセージも追加で検査する
#                                           (working tree の現物では見えない、
#                                           過去に削除済みの denylist 文字列を
#                                           含む — private → public 化の直前に
#                                           使う)。
#   bleep refresh-cache            private/internal リポジトリ一覧
#                                           キャッシュを強制更新する。
#   bleep selftest                 回帰テスト(スタブ gh/git)。
set -euo pipefail

# bash 本体と Cargo.toml の [package].version を揃える。判定レッジャーの
# tool_version フィールドにだけ使う — bump を忘れても実害は小さい(dotfiles
# 側の集約は tool_version を fingerprint に使わない)。
BLEEP_VERSION='0.2.0'

# bleep-hook lex の出力形式の版(src/main.rs の LEX_PROTOCOL と揃える)。
# 出力の先頭行 `#lex <版>` と一致しなければ ask にする(bleep doctor でも検査)。
LEX_PROTOCOL=5

SELF="$(realpath "$0")"
TEST_TMP=''
TARGET_CWD='' # --cwd で明示された対象ディレクトリ(#10/#14 対応)。空なら "." 扱い。

# init_vars: env から派生変数を(再)計算する。selftest が env を export した
# 「後」に呼び直せるよう関数化してある — トップレベルで一度だけ計算すると、
# selftest 内で export した値が既に評価済みの変数に反映されない。
init_vars() {
  CONFIG_DIR="${BLEEP_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/bleep}"
  # 改名前(publish-guard)の設定ディレクトリ。読みはしない(互換 shim は
  # 持たない、README 参照)— require_orgs_file の理由文を「移行未了」に
  # 切り替えるためだけに存在を見る。
  LEGACY_CONFIG_DIR="${BLEEP_LEGACY_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/publish-guard}"
  STATE_DIR="${BLEEP_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/bleep}"
  ORGS_FILE="${BLEEP_ORGS_FILE:-$CONFIG_DIR/orgs.txt}"
  REPOS_FILE="${BLEEP_REPOS_FILE:-$CONFIG_DIR/repos.txt}"
  ALLOW_STOPWORDS_FILE="${BLEEP_ALLOW_STOPWORDS_FILE:-$CONFIG_DIR/allow-stopwords.txt}"
  ALLOW_REGEXES_FILE="${BLEEP_ALLOW_REGEXES_FILE:-$CONFIG_DIR/allow-regexes.txt}"
  ALLOW_PATHS_FILE="${BLEEP_ALLOW_PATHS_FILE:-$CONFIG_DIR/allow-paths.txt}"
  OWNER="${BLEEP_OWNER:-}"
  GH_BIN="${BLEEP_GH_BIN:-gh}"
  LEX_BIN="${BLEEP_LEX_BIN:-bleep-hook}" # cmd_scan_bash_command の字句解析(D1)
  CACHE_TTL="${BLEEP_CACHE_TTL:-86400}"
  # #44: WORD_HARD(裸のリポ名 hard-deny)のうち、この長さ以下の語は
  # word-soft(ask)に降格する。一般的な英単語が私物 private リポ名として
  # たまたま denylist に載ったとき、無関係な公開リポの散文と衝突して
  # hard-deny する事故を減らす(辞書は使わない — ホストごとに有無・内容が
  # 違う `/usr/share/dict/words` に判定を依存させない、build_patterns 参照)。
  # 0 で降格を無効化し、従来(#46 まで)の挙動に戻せる。
  SOFT_MAXLEN="${BLEEP_SOFT_MAXLEN:-4}"
  PRIVATE_CACHE="$STATE_DIR/private-repos-cache.txt"
  VIS_CACHE="$STATE_DIR/visibility-cache.tsv"
  OWNER_CACHE="$STATE_DIR/owner-login-cache.txt"
  # 判定レッジャー(ローカルのみ、送信しない)。契約(場所・レコード形)の
  # 正本は tarotene/dotfiles の ADR + docs/schemas/agent-verdict.schema.json
  # (README「判定レッジャー」参照)。ツール名(agent-verdicts/<tool>.jsonl の
  # <tool>)は bleep 固定 — 複数ツールが同じ鍵で書けるよう、ディレクトリと
  # 鍵ファイルはツール横断で共有する。
  LEDGER_DIR="${BLEEP_LEDGER_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/agent-verdicts}"
  LEDGER_FILE="$LEDGER_DIR/bleep.jsonl"
  LEDGER_KEY_FILE="$LEDGER_DIR/hmac-key"
}
init_vars

usage() {
  cat <<'EOF'
usage: bleep [--cwd DIR] <scan [FILE]|scan-push [--pre-push REMOTE URL]|scan-bash-command CMD|
                       audit [path...] [--remote] [--since REV]|
                       explain TERM_HASH|refresh-cache|doctor|selftest>

エージェント非依存の denylist 判定エンジン。scan/scan-push/scan-bash-command
は exit code で判定を返す: 0=pass, 1=ask(理由を stdout に1行), 2=deny(同)。
BLEEP_ALLOW=1 で3つの scan* サブコマンドを意識的に bypass できる
(README にのみ記載 — 判定結果の理由文には出さない)。

--cwd DIR: PreToolUse hook プロセス自身の cwd ではなく DIR を対象リポジトリの
  位置として扱う(resolve_repo_nwo/compute_push_diff_text/resolve_default_branch
  が `git -C DIR` で参照する)。サブコマンド名より前に置くこと。DIR が無効な
  場合の挙動は既存の fail-loud 経路をそのまま使う — push 差分計算(merge-base
  解決)が失敗すれば ask にエスカレートし、nwo 解決だけが失敗する場合は
  private/internal 早期スキップに入れないまま denylist 照合を続ける(#10/#14
  — フックプロセスの cwd への暗黙依存を解消する)。

設定は $XDG_CONFIG_HOME/bleep/ 以下、一切コミットしない:
  orgs.txt / repos.txt / allow-stopwords.txt / allow-regexes.txt / allow-paths.txt
orgs.txt が存在しなければ scan* は ask を返す(空ファイルは明示的な opt-out)。

doctor: 導入の健全性を検査する。hooks/hooks.json の matcher が Bash と mcp__
  を覆っているか、bleep-hook を実行できるか、bash 本体と bleep-hook の lex
  出力形式の版が一致しているか、有効な pre-push hook が `scan-push --pre-push`
  を呼んでいるか(無いと push は無検査)を ok/NG で印字し、NG があれば exit 1。

scan-push --pre-push REMOTE-NAME REMOTE-URL: git の pre-push hook の入力(stdin の
  `<local-ref> <local-sha> <remote-ref> <remote-sha>`)で push を検査する。
  hooks/pre-push から呼ぶ。引数なしの scan-push は互換経路(ADR-0003)。

explain TERM_HASH: 判定レッジャー(agent-verdicts/bleep.jsonl)の term_hash
  1件から、現在の denylist のどの語がそれに一致するかを人間の端末で復元する
  (#44)。denylist の各語を(bleep-hook hash が使う同じ鍵で)ハッシュし直し、
  一致した語を match_class と共に平文で印字する。判定は変えない(scan* の
  exit code とは無関係)。レッジャーへの追記は行わない。org 名/private repo
  名を平文で印字するため、あなた自身の端末以外(agent が読む Bash 出力など)
  では実行しないこと。
EOF
}

read_lines() { # $1=file; コメント行・空行を除いて出力。ファイル無しは無出力。
  [[ -f "$1" ]] || return 0
  grep -Ev '^[[:space:]]*(#|$)' "$1"
}

# ---- 判定レッジャー(ローカルのみ、送信しない)------------------------------
#
# 「弾かれ続けている」ことを開発元(tarotene/bleep)にフィードバックする
# 仕組みの捕捉点(tarotene/dotfiles の grill-me セッションで裁定)。判定を
# 下したこの場所以外に単一正本を作れない(PreToolUse hook の deny を他の
# hook に通知するイベントを Claude Code/Codex/Copilot のいずれも持たない
# — Anthropic, Hooks reference, https://code.claude.com/docs/en/hooks)。
#
# 書くもの: verdict/reason_id/match_class と、マッチ語をこのマシン固有の
# ランダム鍵で HMAC-SHA256 したハッシュのみ。書かないもの: コマンド本文・
# tool_input・cwd パス・マッチ語の平文・理由文そのもの — bleep の目的が
# 「これらの値を漏らさないこと」なので、判定レッジャー自身がそれを破っては
# 本末転倒になる。
#
# 既定で有効、マシン外へは一切送信しない。DO_NOT_TRACK(空でない値)または
# BLEEP_NO_LEDGER=1 で無効化できる。書き込みに失敗しても判定結果には影響
# させない(fail-open — 判定エンジンの可用性の方を優先する)。

ledger_enabled() {
  [[ -n "${DO_NOT_TRACK:-}" ]] && return 1
  [[ "${BLEEP_NO_LEDGER:-}" == "1" ]] && return 1
  return 0
}

# term_hash: $1=平文のマッチ語 -> hex64(bleep-hook hash に委ねる。鍵の
# 生成・読み書きも bleep-hook 側の責務 — bash 本体はハッシュアルゴリズムを
# 持たない)。失敗したら空文字列(呼び出し側は term_hash を null として書く)。
term_hash() {
  local term="$1"
  [[ -n "$term" ]] || return 0
  mkdir -p "$LEDGER_DIR" 2>/dev/null || return 0
  "$LEX_BIN" hash --key-file "$LEDGER_KEY_FILE" -- "$term" 2>/dev/null || true
}

# ledger_write: $1=deny|ask $2=reason_id $3=match_class(既定 none)
#               $4=平文のマッチ語(既定空、無ければ term_hash は null)
#               $5=detail(既定空。空なら "detail" 欄自体を書かない。閉じた語彙の
#                 失敗コードだけを渡す — 自由文・パス・git の stderr は入れない、#54)
ledger_write() {
  ledger_enabled || return 0
  local verdict="$1" reason_id="$2" match_class="${3:-none}" term="${4-}" detail="${5-}"
  local detail_json=""
  [[ $detail =~ ^[a-z][a-z-]*$ ]] && detail_json=",\"detail\":\"$detail\""
  local hash="" hash_json="null"
  if [[ -n "$term" ]]; then
    hash="$(term_hash "$term")"
    [[ -n "$hash" ]] && hash_json="\"$hash\""
  fi
  local sid_json="null"
  [[ -n "${BLEEP_SESSION_ID:-}" ]] && sid_json="\"${BLEEP_SESSION_ID}\""
  local ts host_field tool_name_field line
  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  host_field="${BLEEP_HOST:-cli}"
  tool_name_field="${BLEEP_TOOL_NAME:-}"
  line="$(printf '{"v":1,"ts":"%s","tool":"bleep","tool_version":"%s","repo":"tarotene/bleep","host":"%s","session_id":%s,"verdict":"%s","reason_id":"%s","match_class":"%s","term_hash":%s,"tool_name":"%s"%s}' \
    "$ts" "$BLEEP_VERSION" "$host_field" "$sid_json" "$verdict" "$reason_id" "$match_class" "$hash_json" "$tool_name_field" "$detail_json")"
  mkdir -p "$LEDGER_DIR" 2>/dev/null || return 0
  chmod 700 "$LEDGER_DIR" 2>/dev/null || true
  (
    flock 9
    printf '%s\n' "$line" >> "$LEDGER_FILE"
  ) 9>>"$LEDGER_FILE.lock" 2>/dev/null || true
}

# ---- allowlist(gitleaks の [[allowlists]] と同型の3軸)----------------------

DEFAULT_STOPWORDS=(.github)
ALLOW_STOPWORDS=()
ALLOW_REGEXES=()
ALLOW_PATHS=()

load_allowlist() {
  ALLOW_STOPWORDS=("${DEFAULT_STOPWORDS[@]}")
  local w
  while IFS= read -r w; do
    [[ -n $w ]] && ALLOW_STOPWORDS+=("$w")
  done < <(read_lines "$ALLOW_STOPWORDS_FILE")

  ALLOW_REGEXES=()
  while IFS= read -r w; do
    [[ -n $w ]] && ALLOW_REGEXES+=("$w")
  done < <(read_lines "$ALLOW_REGEXES_FILE")

  ALLOW_PATHS=()
  while IFS= read -r w; do
    [[ -n $w ]] && ALLOW_PATHS+=("$w")
  done < <(read_lines "$ALLOW_PATHS_FILE")
}

is_stopword() { # $1=word
  local w
  for w in "${ALLOW_STOPWORDS[@]}"; do
    [[ "$1" == "$w" ]] && return 0
  done
  return 1
}

# filter_stopwords: nameref 経由で配列から ALLOW_STOPWORDS に載っている
# 要素を除く(bash 4.3+ の -n を使う。mapfile/BASH_REMATCH 等、既存コードが
# 既に前提する bash バージョンの範囲内)。
filter_stopwords() { # $1=array の変数名
  local -n arr="$1"
  local -a kept=()
  local w
  for w in "${arr[@]}"; do
    is_stopword "$w" || kept+=("$w")
  done
  arr=("${kept[@]}")
}

# text_allow_suppressed: scan 対象テキスト全体に allow-regexes のいずれかが
# マッチしたら 0 を返す。match_verdict() は ask 判定だけをこれで無効化する
# — deny(org/repo 明示参照・具体リポ名一致)は「ほぼ確実に意図しない漏洩」
# なので、周辺文脈の正規表現一致では緩めない。
text_allow_suppressed() { # $1=text
  local text="$1" re
  ((${#ALLOW_REGEXES[@]} > 0)) || return 1
  for re in "${ALLOW_REGEXES[@]}"; do
    grep -Eq -- "$re" <<< "$text" && return 0
  done
  return 1
}

path_allow_suppressed() { # $1=path
  local path="$1" re
  ((${#ALLOW_PATHS[@]} > 0)) || return 1
  for re in "${ALLOW_PATHS[@]}"; do
    grep -Eq -- "$re" <<< "$path" && return 0
  done
  return 1
}

# ---- org/repo のライブ導出 --------------------------------------------------

# resolve_owner_login: BLEEP_OWNER が空なら、現在の gh 認証ユーザの
# login を `gh api user` から live 導出して TTL 付きでキャッシュする。これで
# 「手書きが必要なのは orgs.txt の org 名だけ」になる — 自分のリポジトリの
# 検査は誰にとっても導入即有効。
resolve_owner_login() {
  if [[ -n $OWNER ]]; then
    printf '%s' "$OWNER"
    return 0
  fi
  local now mtime
  now="$(date +%s)"
  if [[ -f $OWNER_CACHE ]]; then
    mtime="$(stat -c %Y "$OWNER_CACHE" 2>/dev/null || stat -f %m "$OWNER_CACHE" 2>/dev/null || printf 0)"
    if (( now - mtime < CACHE_TTL )); then
      cat "$OWNER_CACHE"
      return 0
    fi
  fi
  local login
  login="$("$GH_BIN" api user --jq .login 2>/dev/null)" || return 1
  [[ -n $login ]] || return 1
  mkdir -p "$STATE_DIR"
  printf '%s' "$login" > "$OWNER_CACHE"
  printf '%s' "$login"
}

# refresh_private_repo_cache: 自分の owner 一件 + orgs.txt に書かれた org 名
# それぞれについて、private と internal(gh repo list の --visibility は
# 単一値しか取らないため2回に分ける)のリポジトリを live 取得してキャッシュ
# する(プレーンテキスト、1行1件 "owner/name" 形。#44 — 以前は裸名のみを
# 保存していたため、WORD_SOFT への降格時に owner が分からず NWO_HARD による
# recall 補填ができなかった。jq 不要 — gh の --jq は内蔵の gojq を使うため、
# ローカル jq バイナリに依存しない)。1件でも取得できれば成功とし、全滅した
# 場合だけ失敗を返す(呼び出し側は古いキャッシュにフォールバック)。
refresh_private_repo_cache() {
  mkdir -p "$STATE_DIR"
  local -a owners=()
  local owner org
  owner="$(resolve_owner_login)" && [[ -n $owner ]] && owners+=("$owner")
  while IFS= read -r org; do
    [[ -n $org ]] || continue
    owners+=("$org")
  done < <(read_lines "$ORGS_FILE")
  ((${#owners[@]} > 0)) || return 1

  local tmp got_any=false o vis nwos
  tmp="$(mktemp "$STATE_DIR/private-repos-cache.txt.XXXXXX")"
  : > "$tmp"
  for o in "${owners[@]}"; do
    for vis in private internal; do
      if nwos="$("$GH_BIN" repo list "$o" --visibility "$vis" --limit 500 --json nameWithOwner --jq '.[].nameWithOwner' 2>/dev/null)"; then
        [[ -n $nwos ]] && { printf '%s\n' "$nwos" >> "$tmp"; got_any=true; }
      fi
    done
  done
  if [[ $got_any == true ]]; then
    sort -u "$tmp" -o "$tmp"
    mv "$tmp" "$PRIVATE_CACHE"
    return 0
  fi
  rm -f "$tmp"
  return 1
}

# private_repo_names: キャッシュが TTL 内ならそれを、無ければ live 取得して
# "owner/name" 形で1行1件出力する。live 取得に失敗し、古いキャッシュも無け
# れば何も出力しない(denylist が空になるだけで、検査自体は他の denylist で
# 継続する — orgs.txt/repos.txt が空でなければそれらは引き続き効く)。
# #44: キャッシュに `/` を含まない行(改名前の裸名のみの旧形式)が1つでも
# あれば、TTL に関わらず古い形式とみなして無条件に再取得する。再取得も
# 失敗したら、その旧形式のまま出力する(呼び出し側 build_patterns は `/`
# の有無で owner を判別済みか裸名かを見分け、いずれの場合も WORD_HARD への
# 追加自体は継続する — cache 形式の過渡期でも検査を止めない)。
private_repo_names() {
  local now mtime
  now="$(date +%s)"
  if [[ -f $PRIVATE_CACHE ]]; then
    if grep -Ev '^[[:space:]]*(#|$)' "$PRIVATE_CACHE" | grep -qv '/'; then
      refresh_private_repo_cache || true
      cat "$PRIVATE_CACHE"
      return 0
    fi
    mtime="$(stat -c %Y "$PRIVATE_CACHE" 2>/dev/null || stat -f %m "$PRIVATE_CACHE" 2>/dev/null || printf 0)"
    if (( now - mtime < CACHE_TTL )); then
      cat "$PRIVATE_CACHE"
      return 0
    fi
  fi
  refresh_private_repo_cache || true
  [[ -f $PRIVATE_CACHE ]] && cat "$PRIVATE_CACHE"
  return 0
}

# ---- denylist パターン構築 + 判定 ------------------------------------------

# build_patterns: denylist 3種を集めて4つのパターン配列をグローバル変数に積み、
# allow-stopwords で WORD_HARD/WORD_WARN をフィルタする。
#   PLAIN_PATTERNS  — スラッシュを含む固定文字列。-w は使わない(末尾が "/" の
#                     パターンは -w だと理論上一致し得ない — \> は直前の文字が
#                     word 文字であることを要求するため、"/" 終端では常に不成立)。
#                     stopwords は適用しない — "org/repo" 形の明示参照は
#                     単語単体より曖昧性が無いため。
#   NWO_HARD        — WORD_SOFT に降格した live sweep 由来の語を補う
#                     "owner/name" 形(単語境界一致、hard-deny)。PLAIN_PATTERNS
#                     と違い部分文字列一致ではなく単語境界一致(#44 D3)。
#   WORD_HARD       — 裸のリポ名(単語境界一致、hard-deny)。
#   WORD_WARN       — 裸の org 名(単語境界一致、ask)。
#   WORD_SOFT       — WORD_HARD のうち長さ ≤ SOFT_MAXLEN の裸名(単語境界一致、
#                     ask に降格。#44 — 一般的な英単語が private リポ名として
#                     denylist に載ると、無関係な公開リポの散文と衝突して
#                     hard-deny する事故が起きていた)。
PLAIN_PATTERNS=()
NWO_HARD=()
WORD_HARD=()
WORD_WARN=()
WORD_SOFT=()
build_patterns() {
  PLAIN_PATTERNS=() NWO_HARD=() WORD_HARD=() WORD_WARN=() WORD_SOFT=()
  local org nwo repo
  # #44: 降格した裸名を live sweep の owner に写して NWO_HARD へ足すための
  # 対応表(裸名 -> owner/name)。stopword でも除かれるものは load_allowlist/
  # filter_stopwords の後に降格処理を行うため自然にここへ現れない。
  local -A live_nwo_of=()

  while IFS= read -r org; do
    [[ -n $org ]] || continue
    PLAIN_PATTERNS+=("${org}/")
    WORD_WARN+=("$org")
  done < <(read_lines "$ORGS_FILE")

  while IFS= read -r nwo; do
    [[ -n $nwo ]] || continue
    PLAIN_PATTERNS+=("$nwo")
    repo="${nwo#*/}"
    [[ -n $repo && $repo != "$nwo" ]] && WORD_HARD+=("$repo")
  done < <(read_lines "$REPOS_FILE")

  # live sweep(#44): private_repo_names は "owner/name" 形を返す(旧形式の
  # 裸名キャッシュは private_repo_names 内で検出され自動的に再取得される)。
  # owner が分からない行(旧形式への live 取得失敗フォールバック等)は裸名
  # のまま WORD_HARD に積み、live_nwo_of には登録しない — NWO_HARD による
  # recall 補填が効かないだけで、従来どおり hard-deny は継続する。
  while IFS= read -r nwo; do
    [[ -n $nwo ]] || continue
    repo="${nwo#*/}"
    if [[ -n $repo && $repo != "$nwo" ]]; then
      WORD_HARD+=("$repo")
      live_nwo_of["$repo"]="$nwo"
    else
      WORD_HARD+=("$nwo")
    fi
  done < <(private_repo_names)

  load_allowlist
  filter_stopwords WORD_HARD
  filter_stopwords WORD_WARN

  # #44: stopword フィルタの後に、長さ ≤ SOFT_MAXLEN の WORD_HARD を
  # WORD_SOFT(ask)へ降格する。stopword 済みの語はこの時点で既に WORD_HARD
  # から除かれているため、README「prospectively public」(#15)の「bare 名の
  # stopword で owner/repo 形も含めて両方通る」という既存の約束を壊さない。
  if ((SOFT_MAXLEN > 0)); then
    local -a hard_kept=()
    local w
    for w in "${WORD_HARD[@]}"; do
      if ((${#w} <= SOFT_MAXLEN)); then
        WORD_SOFT+=("$w")
        [[ -n "${live_nwo_of[$w]-}" ]] && NWO_HARD+=("${live_nwo_of[$w]}")
      else
        hard_kept+=("$w")
      fi
    done
    WORD_HARD=("${hard_kept[@]}")
  fi
}

# ---- WORD_HARD/WORD_WARN の単語境界(#35) ----------------------------------
#
# grep -Fw は POSIX の単語構成文字([_[:alnum:]])以外を全て境界とみなす
# ため、`.`/`-` も境界扱いになる。private リポ名が一般語1語(例: "gizmo")
# のとき、無関係な公開リポの拡張子付きファイル名("gizmo.json")や複合語
# ("app-gizmo")まで単語一致してしまい誤 deny/ask する(#35)。拡張子
# (`.` + 英数字)と `-` を非境界にした ERE の境界クラスに置き換える —
# gitleaks の denylist ルールも汎用 `\b` ではなく明示的な境界クラスで前後を
# 書く同種の設計を採る(config/gitleaks.toml)。

ere_escape() { # $1=生の文字列 -> ERE の特殊文字をエスケープしたもの
  printf '%s' "$1" | sed \
    -e 's/\\/\\\\/g' \
    -e 's/\./\\./g' \
    -e 's/\*/\\*/g' \
    -e 's/\^/\\^/g' \
    -e 's/\$/\\$/g' \
    -e 's/+/\\+/g' \
    -e 's/?/\\?/g' \
    -e 's/(/\\(/g' \
    -e 's/)/\\)/g' \
    -e 's/{/\\{/g' \
    -e 's/}/\\}/g' \
    -e 's/|/\\|/g' \
    -e 's/\[/\\[/g' \
    -e 's/\]/\\]/g'
}

# word_boundary_pattern: $1=語(生) -> 1行の ERE パターン。行頭/非境界文字
# のいずれかに続き、語の後ろは行末/非境界文字/「ドット+(行末または非英数字)」
# のいずれかで終わる(拡張子として続く場合だけドットを境界として扱う —
# 文末のドット(「〜gizmo.」のような文)は引き続き一致させる)。
word_boundary_pattern() {
  local esc
  esc="$(ere_escape "$1")"
  printf '(^|[^A-Za-z0-9_.-])%s($|[^A-Za-z0-9_.-]|\\.($|[^A-Za-z0-9]))' "$esc"
}

# word_boundary_pattern_file: $1=配列名 -> 各要素を1行のパターンに変換した
# ものを stdout に印字する。grep -f に渡す複数行は独立した alternative として
# OR 評価される(-F の複数パターンファイルと同じ使い方)。
word_boundary_pattern_file() {
  local -n arr_ref="$1"
  local w
  for w in "${arr_ref[@]}"; do
    word_boundary_pattern "$w"
    printf '\n'
  done
}

# find_matched_word: $1=配列名 $2=text -> 配列中で実際に一致した最初の語を
# 平文で stdout に印字する(MATCH_TERM 用)。grep -Eo で全体マッチ文字列を
# 拾うと境界クラスの文字(先頭1文字・末尾最大2文字)が混入するため、既知の
# 語彙を1件ずつ当て直して裸の語をそのまま採用する(還元 — 新しい抽出
# ロジックを増やさず、既に持っている語のリストに戻す)。
find_matched_word() {
  local -n arr_ref="$1"
  local text="$2" w
  for w in "${arr_ref[@]}"; do
    grep -Eq "$(word_boundary_pattern "$w")" <<< "$text" && { printf '%s' "$w"; return 0; }
  done
  return 1
}

# match_verdict: $1 の中身を denylist と突き合わせ、一致すれば 0 を返す。
# 一致しなければ非 0 を返す(何も印字しない)。判定結果はグローバル変数
# VERDICT(deny/ask)に、判定レッジャー用の付随情報は MATCH_CLASS/
# MATCH_TERM(マッチしたパターンの種別と実際のマッチ語、平文)にセットする。
# 呼び出し側は `$(match_verdict ...)` のようにコマンド置換で囲んではならない
# — サブシェルで実行されるとこれらのグローバル変数への代入が親シェルに
# 反映されない。必ず `if match_verdict "$text"; then ...` の形で直接呼ぶ。
# MATCH_CLASS/MATCH_TERM の抽出は既存の -q 判定条件が真になった後に追加の
# grep -o で行うため、判定結果(VERDICT)への影響はない。呼び出し側は
# MATCH_TERM をレッジャーに書く前に必ずハッシュ化すること(平文のまま
# 書いてはいけない)。
VERDICT=''
MATCH_CLASS=''
MATCH_TERM=''
match_verdict() {
  local text="$1"
  VERDICT='' MATCH_CLASS='' MATCH_TERM=''
  if ((${#PLAIN_PATTERNS[@]} > 0)) && grep -Fqf <(printf '%s\n' "${PLAIN_PATTERNS[@]}") <<< "$text"; then
    MATCH_CLASS='plain'
    MATCH_TERM="$(grep -Fof <(printf '%s\n' "${PLAIN_PATTERNS[@]}") <<< "$text" | head -n1 || true)"
    VERDICT='deny'
    return 0
  fi
  # #44 D3: WORD_SOFT に降格した語の "owner/name" 形の recall 補填。
  # org/repo 形と同じ曖昧性の無さで hard-deny する点は PLAIN_PATTERNS と
  # 同じ意味を持つため match_class は共用の 'plain' を使う(新しい
  # match_class を増やさない — reason_id_for_verdict/verdict_reason も
  # PLAIN_PATTERNS と分岐を共有できる)。
  if ((${#NWO_HARD[@]} > 0)) && grep -Eqf <(word_boundary_pattern_file NWO_HARD) <<< "$text"; then
    MATCH_CLASS='plain'
    MATCH_TERM="$(find_matched_word NWO_HARD "$text" || true)"
    VERDICT='deny'
    return 0
  fi
  if ((${#WORD_HARD[@]} > 0)) && grep -Eqf <(word_boundary_pattern_file WORD_HARD) <<< "$text"; then
    MATCH_CLASS='word-hard'
    MATCH_TERM="$(find_matched_word WORD_HARD "$text" || true)"
    VERDICT='deny'
    return 0
  fi
  # #44: 長さ ≤ SOFT_MAXLEN の裸リポ名は ask に降格(一般語との偶然一致を
  # 人間に確認させる、pass にはしない — fail-loud)。allow-regexes による
  # ask の抑止は WORD_WARN と同じ仕組みを流用する。
  if ((${#WORD_SOFT[@]} > 0)) && grep -Eqf <(word_boundary_pattern_file WORD_SOFT) <<< "$text"; then
    text_allow_suppressed "$text" && return 1
    MATCH_CLASS='word-soft'
    MATCH_TERM="$(find_matched_word WORD_SOFT "$text" || true)"
    VERDICT='ask'
    return 0
  fi
  if ((${#WORD_WARN[@]} > 0)) && grep -Eqf <(word_boundary_pattern_file WORD_WARN) <<< "$text"; then
    text_allow_suppressed "$text" && return 1
    MATCH_CLASS='word-warn'
    MATCH_TERM="$(find_matched_word WORD_WARN "$text" || true)"
    VERDICT='ask'
    return 0
  fi
  return 1
}

# verdict_reason: $1=deny|ask $2=match_class -> 理由文(bypass 手段は
# ここに書かない。README 参照)。#44: word-soft(短いリポ名の裸一致)は
# word-warn(org 名の裸一致)と文言を分ける — 語は出さない。
verdict_reason() {
  local verdict="$1" match_class="${2:-none}"
  case "$verdict:$match_class" in
    deny:*) printf 'denylist に登録された company/private リポジトリの参照と一致しました。' ;;
    ask:word-soft) printf 'denylist に登録された短いリポジトリ名(%s 文字以下)の裸の単体出現と一致しました。一般語との偶然の一致か確認してください。' "$SOFT_MAXLEN" ;;
    ask:*) printf 'denylist に登録された org 名の裸の単体出現と一致しました。正当な用途(例: メールドメイン)か確認してください。' ;;
  esac
}

# match_verdict の結果から reason_id(判定レッジャーの閉語彙)を決める。
# $1=deny|ask $2=match_class。#44: ask の reason_id は match_class で
# 分岐する(word-soft はリポ名一致なので repo-ref、word-warn は org 名
# 一致なので org-bare — reason_id の閉語彙自体は変更しない)。
reason_id_for_verdict() {
  local verdict="$1" match_class="${2:-none}"
  case "$verdict" in
    deny) printf 'repo-ref' ;;
    ask)
      case "$match_class" in
        word-soft) printf 'repo-ref' ;;
        *) printf 'org-bare' ;;
      esac
      ;;
  esac
}

# emit_verdict: $1=deny|ask $2=reason(理由文) $3=reason_id
#               $4=match_class(既定 none) $5=平文のマッチ語(既定空)
# レッジャーに書いてから理由を印字し、対応する exit code で終了する。
emit_verdict() {
  local verdict="$1" reason="$2" reason_id="$3" match_class="${4:-none}" term="${5-}" detail="${6-}"
  ledger_write "$verdict" "$reason_id" "$match_class" "$term" "$detail"
  printf '%s\n' "$reason"
  case "$verdict" in
    deny) exit 2 ;;
    ask) exit 1 ;;
  esac
}

# require_orgs_file: orgs.txt が存在しなければ ask で終了する(fail-loud)。
# read_lines は「ファイル無し = 無出力」なので、orgs.txt が無いホストでは
# org 由来の denylist が黙って空になる。しかも denylist 全体は空にならない
# (private キャッシュは gh 認証ユーザ自身の private リポからも導出される)
# ため、「denylist が空なら ask」では検出できない — 設定ファイルの存在
# そのものを前提条件にする。空ファイルは「org を登録しない」という明示的な
# 選択として従来どおり通す。publish 系の検査経路(cmd_scan / cmd_scan_push /
# cmd_scan_bash_command の gh 分岐)でだけ呼ぶ — git status 等の無関係な
# コマンドは従来どおり pass させる。
require_orgs_file() {
  [[ -f $ORGS_FILE ]] && return 0
  if [[ -d $LEGACY_CONFIG_DIR ]]; then
    emit_verdict ask "bleep の設定が改名前の場所に残っています(${LEGACY_CONFIG_DIR} → ${CONFIG_DIR} への移行が未了)。org denylist が読まれていません。README の Upgrading 手順で移行してください。" legacy-config
  fi
  # #42: home-manager 等の宣言的な設定生成が、対象ファイルを一時的に
  # `<file>.backup` へ退避してから再生成する運用(dotfiles 側 ADR の
  # 「wrapper flake 経由でない直接適用」事故と同型)だと、この退避直後の
  # 数秒〜数分だけ orgs.txt が不在になる。`.backup` が隣にあれば、その
  # 可能性が高いことと、エージェントが自分の判断で復元してはいけないこと
  # (denylist の中身は人間が決める値であり、`.backup` の内容が正しいとも
  # 限らない)を理由文に加える — 診断性のためだけで、bleep 自身が復元する
  # わけではない。
  if [[ -f "${ORGS_FILE}.backup" ]]; then
    emit_verdict ask "bleep が未設定です(${ORGS_FILE} がありません)。隣に ${ORGS_FILE}.backup があるため、宣言的な設定生成(dotfiles 等の home-manager 管理)が対象ファイルを退避した直後である可能性が高いです。宣言の再適用で復元してください — .backup の中身が正しいとも限らないため、エージェントが自分の判断でそこから復元してはいけません。人間の判断を待ってください。" unconfigured
  fi
  emit_verdict ask "bleep が未設定です(${ORGS_FILE} がありません)。org denylist が空のまま公開面を検査しています。この設定を宣言的に生成している場合(dotfiles 等の home-manager 管理)は、その適用を再実行してください。手で作る場合も、登録する org 名(または空ファイルによる明示的な opt-out)を決めるのは人間の判断です — エージェントが推測で作らないでください。" unconfigured
}

# ---- push 差分 / リポジトリ可視性 ------------------------------------------

# resolve_default_branch: scripts/git-audit-worktrees(dotfiles)の同名関数と
# 同じ idiom。TARGET_CWD(--cwd)が空なら "." = 呼び出しプロセスの cwd。
resolve_default_branch() {
  local dir="${TARGET_CWD:-.}"
  local ref b
  ref="$(git -C "$dir" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null)" || ref=""
  if [[ -n $ref ]]; then
    printf '%s' "${ref#origin/}"
    return 0
  fi
  for b in main master; do
    git -C "$dir" show-ref --verify --quiet "refs/heads/$b" && { printf '%s' "$b"; return 0; }
  done
  printf ''
}

# push_diff_fail: compute_push_diff_text の失敗を「[コード] 理由文」の1行で
# stdout に書いて非 0 を返す。コードは閉じた語彙(dir-missing / not-a-repo /
# default-branch / merge-base / range)で、呼び出し側が判定レッジャーの
# detail 欄に残す(#54 — 以前は理由文が画面にしか出ず、後から原因を辿れなかった)。
push_diff_fail() {
  printf '[%s] %s\n' "$1" "$2"
  return 1
}

# diff_text_for_range: git log の rev 指定(範囲 `A..B`、`X --not --remotes=R`、
# 単独 commit の `-1 SHA` など)から、「追加行」+ 新規/rename 先ファイルパス +
# コミットメッセージを連結して出力する(#7 — 削除行は既公開内容の除去であり
# 新規公開ではないため検査対象外)。push の検査(scan-push の 2 経路)と
# audit --since が共有する単一の抽出正本(D7)。$1=対象ディレクトリ。
# git log が失敗したら「[range] 理由文」を stdout に1行書いて非 0 を返す
# (fail-loud — 失敗が「追加行なし」= pass にならないよう、終了コードで検出する、
# #54)。理由文を stdout に乗せるのは、呼び出し側が常に `text="$(fn)"`
# (コマンド置換 = サブシェル)で呼ぶためで、グローバル変数への代入は親に
# 伝わらないから(#39)。
diff_text_for_range() {
  local dir="$1"
  shift
  local patches names msgs
  # per-commit patch(--format= でメッセージを混ぜない)。merge コミットは
  # --diff-merges=first-parent で第1親との diff を出す — evil merge(どちらの
  # 親にも無い行を解決結果に足す)の追加行もここに現れる。--no-renames で
  # rename を add+delete に展開し、-U0 で無関係な文脈行を落とす。
  if ! patches="$(git -C "$dir" log -p --diff-merges=first-parent --no-renames --unified=0 --format= "$@" 2>/dev/null)"; then
    push_diff_fail range "git log が失敗しました(範囲: $*)。"
    return 1
  fi
  # 追加/rename 先のファイルパスは patch 本文に依存せず明示的に列挙する
  # (空ファイル・バイナリには +++ ヘッダ自体が出ないため、grep '^+' だけでは
  # パス名検出が漏れる)。
  if ! names="$(git -C "$dir" log --diff-merges=first-parent --no-renames --diff-filter=A --name-only --format= "$@" 2>/dev/null)" ||
    ! msgs="$(git -C "$dir" log --format=%B "$@" 2>/dev/null)"; then
    push_diff_fail range "git log が失敗しました(範囲: $*)。"
    return 1
  fi

  grep '^+' <<< "$patches" || true # 追加行のみ抽出。無一致(grep の非 0)は空でよい
  printf '%s\n' "$names"
  printf '%s\n' "$msgs"
  return 0
}

# push_dir_check: $1=push 対象ディレクトリが git リポジトリとして読めるか。
# 読めなければ「[コード] 理由文」を stdout に書いて非 0(#39 — 以前は
# merge-base 失敗の理由文に埋もれ、tilde 未展開等による無効な --cwd を
# 利用者が特定できなかった)。
push_dir_check() {
  local dir="$1" git_err
  if [[ ! -d $dir ]]; then
    push_diff_fail dir-missing "push 対象ディレクトリが存在しません: ${dir}"
    return 1
  fi
  if ! git_err="$(git -C "$dir" rev-parse --git-dir 2>&1 >/dev/null)"; then
    push_diff_fail not-a-repo "push 対象が git リポジトリとして読めません: ${dir} (${git_err%%$'\n'*})"
    return 1
  fi
  return 0
}

# compute_push_diff_text: 引数なしの `scan-push`(従来の経路)が検査する範囲 —
# default branch との merge-base..HEAD — の差分テキストを出力する。範囲が
# 解決できない場合は非 0 を返し、「[コード] 理由文」を stdout に1行書く
# (fail-loud — 呼び出し側はこれを ask にエスカレートする。無言の pass には
# しない、#39)。
#
# PreToolUse の `git push` コマンド文字列から push の範囲を推測する経路(#54 の
# PUSH_SPEC)は廃止した(ADR-0003): コマンドの書き方に依存する推測は、新規
# ブランチ・別 worktree・shallow clone などで外れ、同じ偽陽性の ask を繰り返し
# 生んだ(#67/#69/#73)。push の範囲は git の pre-push が stdin で渡す正確な
# ref と SHA から求める(cmd_scan_pre_push)。この関数は、pre-push の配線が
# stdin を渡さない旧い呼び出し(`bleep scan-push < /dev/null`)のための互換経路
# として残している。
compute_push_diff_text() {
  local dir="${TARGET_CWD:-.}"
  push_dir_check "$dir" || return 1

  local default_branch base
  default_branch="$(resolve_default_branch)"
  if [[ -z $default_branch ]]; then
    push_diff_fail default-branch "default branch を解決できませんでした(origin/HEAD 未設定・main/master 不在)。"
    return 1
  fi
  base="$(git -C "$dir" merge-base HEAD "origin/$default_branch" 2>/dev/null)" || base=""
  if [[ -z $base ]]; then
    push_diff_fail merge-base "origin/${default_branch} との merge-base を解決できませんでした(未 fetch の可能性)。"
    return 1
  fi
  diff_text_for_range "$dir" "$base..HEAD"
}

# resolve_repo_nwo: $1(省略可)がシェルコマンド文字列なら --repo/-R 明示
# 指定を優先し、無ければ(または $1 が空なら)TARGET_CWD(--cwd。無指定なら
# 呼び出しプロセスの cwd)の origin リモートから owner/repo を導出する。
# どちらも取れなければ非 0(#10/#14 — 以前はここが常にプロセス自身の cwd
# 固定だった)。
resolve_repo_nwo() {
  local cmd="${1-}"
  if [[ -n $cmd ]] && [[ $cmd =~ (--repo|-R)[=\ ]+([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+) ]]; then
    printf '%s' "${BASH_REMATCH[2]}"
    return 0
  fi
  local url
  url="$(git -C "${TARGET_CWD:-.}" remote get-url origin 2>/dev/null)" || return 1
  nwo_from_url "$url"
}

# nwo_from_url: $1=git remote の URL -> github.com の owner/repo(標準出力)。
# owner/repo の形に読めなければ非 0。可視性の判定に使うだけで、読めない
# ときは UNKNOWN 扱い(検査続行)になる。
nwo_from_url() {
  local url="${1%.git}"
  url="${url#git@github.com:}"
  url="${url#https://github.com/}"
  url="${url#ssh://git@github.com/}"
  [[ -n $url && $url == */* ]] || return 1
  printf '%s' "$url"
}

# repo_visibility: $1=owner/repo -> PUBLIC/PRIVATE/INTERNAL/UNKNOWN。
# TTL 付きキャッシュ(TSV: nwo, visibility, checked-at epoch)。取得に失敗したら
# UNKNOWN を返す — 呼び出し側は UNKNOWN を PUBLIC と同じ扱い(検査続行)にする
# (判定不能を「検査しない理由」にしない fail-loud の一環)。
repo_visibility() {
  local nwo="$1" now line r v t
  now="$(date +%s)"
  if [[ -f $VIS_CACHE ]]; then
    while IFS=$'\t' read -r r v t; do
      [[ $r == "$nwo" ]] || continue
      if (( now - t < CACHE_TTL )); then
        printf '%s' "$v"
        return 0
      fi
      break
    done < "$VIS_CACHE"
  fi
  local vis
  vis="$("$GH_BIN" repo view "$nwo" --json visibility --jq .visibility 2>/dev/null)" || vis=""
  [[ -n $vis ]] || { printf 'UNKNOWN'; return 0; }
  mkdir -p "$STATE_DIR"
  local tmp
  tmp="$(mktemp "$STATE_DIR/visibility-cache.tsv.XXXXXX")"
  { [[ -f $VIS_CACHE ]] && awk -F'\t' -v r="$nwo" '$1 != r' "$VIS_CACHE"
    printf '%s\t%s\t%s\n' "$nwo" "$vis" "$now"; } > "$tmp"
  mv "$tmp" "$VIS_CACHE"
  printf '%s' "$vis"
}

# ---- サブコマンド -----------------------------------------------------------

# cmd_scan: 任意のテキスト(stdin または FILE)を denylist と突き合わせる。
# MCP tool_input など、シェルコマンド文字列でない入力全般が対象。stdin/FILE
# を読めなければ ask にエスカレートする(以前は無言 exit 0 だった)。
cmd_scan() {
  local src="${1--}" text
  if [[ $src == "-" || -z $src ]]; then
    if ! text="$(cat)"; then
      emit_verdict ask "stdin を読み取れませんでした。" engine-unavailable
    fi
  else
    if ! text="$(cat "$src" 2>/dev/null)"; then
      emit_verdict ask "${src} を読み取れませんでした。" engine-unavailable
    fi
  fi
  require_orgs_file
  build_patterns
  if match_verdict "$text"; then
    emit_verdict "$VERDICT" "$(verdict_reason "$VERDICT" "$MATCH_CLASS")" "$(reason_id_for_verdict "$VERDICT" "$MATCH_CLASS")" "$MATCH_CLASS" "$MATCH_TERM"
  fi
  exit 0
}

# explain_scan_array: $1=match_class $2=配列名 $3=探す term_hash -> 配列の
# 各語を term_hash() で再ハッシュし、一致した語があれば
# "<match_class>\t<平文>" を1行印字して 0 を返す(見つからなければ非 0、
# 何も印字しない)。cmd_explain から PLAIN_PATTERNS/WORD_HARD/WORD_WARN の
# 3系列に対して呼ぶ小さな純粋ヘルパー(既存の find_matched_word と同じ
# 「既知の語彙を1件ずつ当て直す」還元)。
explain_scan_array() {
  local -n arr_ref="$2"
  local target="$3" w h
  for w in "${arr_ref[@]}"; do
    h="$(term_hash "$w")"
    if [[ -n $h && $h == "$target" ]]; then
      printf '%s\t%s\n' "$1" "$w"
      return 0
    fi
  done
  return 1
}

# cmd_explain: $1=term_hash(hex64) -> 現在の denylist の各語を term_hash()
# で同じ鍵で再ハッシュし、一致した語を match_class と共に平文で stdout に
# 印字する(#44 — レッジャーは HMAC のみ保持し、どの語が deny/ask を
# 引いたか事後に人間が特定する手段が無かった)。判定エンジン(match_verdict)
# には一切触れない — 診断専用で scan* の判定結果に影響しない。orgs.txt
# 不在でも動く(require_orgs_file を呼ばない。診断コマンドで ask を返す
# 意味がないため)。レッジャーへの書き込みも行わない(ledger_write を
# 呼ばない — 診断行為自体を判定として記録しない)。
cmd_explain() {
  local target="${1-}"
  if [[ -z $target ]] || [[ ! $target =~ ^[0-9a-f]{64}$ ]]; then
    printf '使い方: bleep explain TERM_HASH(agent-verdicts/bleep.jsonl の term_hash、hex64)\n' >&2
    return 2
  fi
  [[ -f $ORGS_FILE ]] || printf '注意: %s が存在しません。org 由来の denylist は空のまま照合します。\n' "$ORGS_FILE" >&2
  build_patterns

  local found=0
  explain_scan_array plain PLAIN_PATTERNS "$target" && found=1
  explain_scan_array plain NWO_HARD "$target" && found=1
  explain_scan_array word-hard WORD_HARD "$target" && found=1
  explain_scan_array word-soft WORD_SOFT "$target" && found=1
  explain_scan_array word-warn WORD_WARN "$target" && found=1

  if [[ $found -eq 0 ]]; then
    printf '現在の denylist に一致なし(cache/allow-stopwords が判定時と変わった可能性があります)。\n' >&2
    return 1
  fi
  return 0
}

# cmd_scan_push: これから push する差分を検査する。2 つの呼び方がある。
#   bleep scan-push --pre-push REMOTE-NAME REMOTE-URL < (pre-push の stdin)
#     git の pre-push hook(hooks/pre-push)から呼ぶ本命の経路。範囲は git が
#     stdin で渡す `<local-ref> <local-sha> <remote-ref> <remote-sha>` から
#     求める(cmd_scan_pre_push)。
#   bleep scan-push
#     引数なし。cwd の default branch との merge-base..HEAD を検査する従来の
#     経路。pre-push の配線が stdin を渡さない旧い呼び出し向けの互換経路で、
#     新規ブランチ・shallow clone などでは範囲を求められず ask になる
#     (#69/#73)— 配線を `--pre-push` に切り替えれば起きない。
# どちらも、対象リポジトリが PRIVATE/INTERNAL と判明していれば検査自体を
# スキップする(これは「検査しない」という正当な判定であり、fail-loud の
# 対象ではない)。diff/log 自体が計算できない場合は ask にエスカレートする。
cmd_scan_push() {
  if [[ ${1-} == --pre-push ]]; then
    shift
    cmd_scan_pre_push "$@"
    return
  fi
  local nwo vis
  nwo="$(resolve_repo_nwo)" || nwo=""
  if [[ -n $nwo ]]; then
    vis="$(repo_visibility "$nwo")"
    [[ $vis == PRIVATE || $vis == INTERNAL ]] && exit 0
  fi

  local text
  if ! text="$(compute_push_diff_text)"; then
    local code="${text#\[}"
    code="${code%%\]*}"
    emit_verdict ask "push 差分を検査できませんでした: ${text}" push-diff-failed none "" "$code"
  fi
  require_orgs_file
  build_patterns
  if match_verdict "$text"; then
    emit_verdict "$VERDICT" "$(verdict_reason "$VERDICT" "$MATCH_CLASS")" "$(reason_id_for_verdict "$VERDICT" "$MATCH_CLASS")" "$MATCH_CLASS" "$MATCH_TERM"
  fi
  exit 0
}

# push_range_for_ref: pre-push の 1 行(local-sha / remote-sha)から git log の
# rev 指定を求め、配列 push_range に入れる。範囲は 2 通り:
#   - remote-sha が全 0 でなく、ローカルにある commit なら `remote..local`
#     (既存ブランチの更新)。
#   - それ以外(新規ブランチ、shallow clone でリモートの先端が手元に無い、
#     リモートが先行している)は `local --not --remotes=<remote>`。追跡 ref が
#     1 本も無ければ `local` だけ — リモートに何があるか分からない以上、
#     履歴全体が公開されるので全部が検査対象で正しい。
# $1=dir $2=remote-name $3=local-sha $4=remote-sha
push_range=()
push_range_for_ref() {
  local dir="$1" remote="$2" lsha="$3" rsha="$4"
  if [[ ! $rsha =~ ^0+$ ]] && git -C "$dir" cat-file -e "${rsha}^{commit}" 2>/dev/null; then
    push_range=("${rsha}..${lsha}")
  else
    push_range=("$lsha" --not "--remotes=$remote")
  fi
}

# attribute_commit: push_range の commit を 1 つずつ照合し直し、最初に一致した
# commit の短い SHA を出力する(#67 — どの commit が止めたかが分からず、
# 一致が context 行なのか中間 commit の patch なのかを切り分けられなかった)。
# 語は出さない。100 commit を超える範囲は属性づけを諦めて空を返す。
# match_verdict のグローバル(VERDICT 等)を壊すので、呼び出し側は先に退避する。
# $1=dir、範囲は配列 push_range。
attribute_commit() {
  local dir="$1" sha t n=0
  while IFS= read -r sha; do
    [[ -n $sha ]] || continue
    n=$((n + 1))
    ((n <= 100)) || return 0
    t="$(diff_text_for_range "$dir" -1 "$sha")" || continue
    if match_verdict "$t"; then
      git -C "$dir" rev-parse --short "$sha" 2>/dev/null
      return 0
    fi
  done < <(git -C "$dir" rev-list "${push_range[@]}" 2>/dev/null)
  return 0
}

# cmd_scan_pre_push: git の pre-push hook の入力で push を検査する(ADR-0003)。
# $1=remote の名前 $2=remote の URL(pre-push hook の引数そのまま)。stdin は
# 1 ref 1 行 `<local-ref> <local-sha> <remote-ref> <remote-sha>`。コマンドの
# 書き方(`git -C`、`cd`、変数、refspec の省略形)に関係なく、git が正規化した
# ref と完全な SHA が来るので、範囲を推測しない。
# pre-push には ask を確かめる手段が無いので、hooks/pre-push は ask(exit 1)も
# 止める。
cmd_scan_pre_push() {
  local remote="${1-}" url="${2-}"
  [[ -n $remote ]] || { usage >&2; exit 2; }
  local dir="${TARGET_CWD:-.}"

  local nwo vis
  nwo="$(nwo_from_url "$url")" || nwo=""
  if [[ -n $nwo ]]; then
    vis="$(repo_visibility "$nwo")"
    [[ $vis == PRIVATE || $vis == INTERNAL ]] && exit 0
  fi

  local lref lsha rref rsha chunk text='' dir_err
  if ! dir_err="$(push_dir_check "$dir")"; then
    local code="${dir_err#\[}"
    code="${code%%\]*}"
    emit_verdict ask "push 差分を検査できませんでした: ${dir_err}" push-diff-failed none "" "$code"
  fi
  local -a all_ranges=()
  while read -r lref lsha rref rsha; do
    [[ -n $lsha ]] || continue
    # 削除(local が (delete) で sha が全 0)は公開する内容が無い。
    [[ $lsha =~ ^0+$ ]] && continue
    push_range_for_ref "$dir" "$remote" "$lsha" "$rsha"
    if ! chunk="$(diff_text_for_range "$dir" "${push_range[@]}")"; then
      local code="${chunk#\[}"
      code="${code%%\]*}"
      emit_verdict ask "push 差分を検査できませんでした: ${chunk}" push-diff-failed none "" "$code"
    fi
    text+="$chunk"$'\n'
    all_ranges+=("${push_range[*]}")
  done

  [[ -n $text ]] || exit 0
  require_orgs_file
  build_patterns
  if match_verdict "$text"; then
    local verdict="$VERDICT" class="$MATCH_CLASS" term="$MATCH_TERM"
    local reason sha='' r
    reason="$(verdict_reason "$verdict" "$class")"
    for r in "${all_ranges[@]}"; do
      read -r -a push_range <<< "$r"
      sha="$(attribute_commit "$dir")"
      [[ -n $sha ]] && break
    done
    [[ -n $sha ]] && reason+=" 一致した commit: ${sha}(git show ${sha} で確認できます)。"
    emit_verdict "$verdict" "$reason" "$(reason_id_for_verdict "$verdict" "$class")" "$class" "$term"
  fi
  exit 0
}

# ---- コマンド文字列の字句解析(#9/#14 対応、D1) ----------------------------
#
# 以前の cmd_scan_bash_command は正規表現で CMD 全体を検索していた
# (`gh[[:space:]]+(pr|issue)...` / `git[[:space:]]+push`)。これは2つの
# 問題を生んでいた:
#   1. `git -C <dir> push` / `gh --repo x pr create` のように、サブコマンド
#      の前に global option を1個挟むだけで正規表現の隣接一致が崩れ、
#      どちらの分岐にも入らず無検査 pass になる(#14 で発見)。
#   2. gh 分岐の match_verdict の照合対象が CMD 全文だったため、
#      `cd <private リポ名を含むパス> && gh pr create ...` のように
#      対象リポジトリ自身の名前がパス経由で含まれるだけで hard-deny する
#      (#9)。
#
# CMD を `;`/`&&`/`||`/`|`/改行 で区切ったセグメントに分け、セグメントごとに
# トークン位置で分類する(隣接一致ではなく位置で見る)必要があった。この
# セグメント分割・トークン化・分類・cd 積み重ねによる実効ディレクトリ解決
# (旧 split_command_segments/tokenize_segment/classify_segment/
# resolve_effective_dir)は $LEX_BIN(bleep-hook、src/lex.rs)に
# 移した — 純粋関数のみ(I/O・gh・キャッシュ非依存)で、判定を運ばない
# 継ぎ目のため、この本体の判断ロジック(match_verdict/build_patterns/
# resolve_repo_nwo)には影響しない。移植の経緯・字句解析だけを Rust に
# 委ねた理由は bleep-wise-elephant の Plan(#22 で見つかった
# fail-open の退行 — 自前実装がシェルの引用規則を不完全に近似していた)
# を参照。

# noncanonical_reason_text: $1=gh の投稿が正準形を外れた理由コード(src/grammar.rs の
# NONCANONICAL_CODES)-> 理由文。正準形の定義と、書き直し方を案内する。bypass 手段は
# ここに書かない(README 参照)。
noncanonical_reason_text() {
  local base='gh の投稿は、次の正準形だけを受け付けます: gh <pr|issue> <create|edit|comment> -R OWNER/REPO … --body-file /絶対/パス(本文は先にファイルへ書き、絶対パスのリテラルで渡す。release は --notes-file)。'
  local why
  case "$1" in
    no-repo) why='宛先 -R OWNER/REPO がありません(cwd の origin からは推測しません)。' ;;
    bad-repo) why='-R の値、または gh api の宛先が、リテラルの OWNER/REPO ではありません(変数や {owner} プレースホルダは使えません)。' ;;
    inline-body) why='本文を --body/-b/--notes/-n で直接渡す形は使えません。' ;;
    inline-comment) why='close/reopen の --comment は使えません。gh <pr|issue> comment --body-file で本文を投稿してから close してください。' ;;
    body-stdin) why='本文を標準入力(-、/dev/stdin、ヒアドキュメント)で渡す形は使えません。' ;;
    body-path) why='本文ファイルのパスが絶対パスのリテラルではありません(相対パス・~・変数は使えません)。' ;;
    dynamic-value) why='コマンド置換や変数展開($(…)、バッククォート、$VAR)を含む値は使えません。リテラルで書いてください。' ;;
    not-alone) why='本文ファイルを持つ投稿は、その投稿だけを 1 回のコマンドとして実行してください(&&・;・|・改行で他のコマンドと並べる形、sh -c・eval・$(…) の中は使えません。同じコマンドの前段が本文ファイルを書き換えると、照合した中身と投稿される中身がずれるため)。前段の処理は別の Bash 呼び出しに分けてください。' ;;
    unparsable) why='コマンドを解釈できません(クォートが閉じていません)。本文はファイルに書いて --body-file で渡してください。' ;;
    *) why='正準形を外れています。' ;;
  esac
  printf '%s %s' "$why" "$base"
}

# cmd_scan_bash_command: CMD の字句解析(セグメント分割・"git push" 形/gh の投稿の
# 認識・正準形かどうかの判定)は $LEX_BIN(bleep-hook、D1)に委ねる。この
# バイナリは純粋関数のみで I/O・gh を一切行わないため、判定不能を無言 pass
# にしない fail-loud の格は落ちない — 起動自体に失敗したら ask にエスカレート
# する(下記 lex_out の読み取り失敗を参照)。出力は先頭の `#lex <版>` 行と、
# found_push/push_bypass/投稿の件数と投稿ごとの(違反コード・宛先・本文の入力元)
# + scan_subject(jq 非依存を保つための独自の単純書式、bleep-hook lex --help
# 参照)。照合対象(scan subject)は CMD 全文から `cd <単一トークン>`
# セグメントだけを除いたもの(#9)。git push は pre-push hook を無効にする
# 形だけを deny し、中身は見ない(pre-push が検査する、ADR-0003)。gh の投稿は
# 正準形だけを受理し、外れた形は deny する(ADR-0003)。どちらの形も無ければ
# 無検査で pass(フォールスルー)。Claude/Codex/Copilot の Bash 系 host が
# 共通で呼ぶ、シェルコマンド用の唯一の判定入口。
cmd_scan_bash_command() {
  local cmd="${1-}"
  [[ -n $cmd ]] || { usage >&2; exit 2; }

  local lex_out
  if ! lex_out="$("$LEX_BIN" lex --cwd "${TARGET_CWD:-.}" -- "$cmd" 2>/dev/null)"; then
    emit_verdict ask "コマンドの字句解析に失敗しました(bleep-hook が見つからないか実行できません)。" lex-failed
  fi

  local found_push push_bypass n_posts scan_subject lex_header i n k body_path
  local -a post_code=() post_repo=() post_body_n=() all_bodies=()
  {
    IFS= read -r lex_header
    if [[ $lex_header != "#lex ${LEX_PROTOCOL}" ]]; then
      emit_verdict ask "bleep-hook の lex 出力形式(${lex_header:-空})が bleep 本体(#lex ${LEX_PROTOCOL})と一致しません。bleep と bleep-hook を同じ版に揃えてください(bleep doctor で確認できます)。" lex-protocol-mismatch
    fi
    IFS= read -r found_push
    IFS= read -r push_bypass
    IFS= read -r n_posts
    for ((i = 0; i < n_posts; i++)); do
      IFS= read -r k
      post_code+=("$k")
      IFS= read -r k
      post_repo+=("$k")
      IFS= read -r n
      post_body_n+=("$n")
      for ((k = 0; k < n; k++)); do
        IFS= read -r body_path
        all_bodies+=("$body_path")
      done
    done
    scan_subject="$(cat)"
  } <<< "$lex_out"

  # ADR-0003: push の中身は PreToolUse では見ない。コマンド文字列から push の
  # 範囲を推測する経路は、新規ブランチ・別 worktree・shallow clone で外れて
  # 同じ偽陽性の ask を繰り返した(#67/#69/#73)。検査は git の pre-push
  # (hooks/pre-push → `scan-push --pre-push`)が、git が渡す正確な ref と SHA
  # で行う。ここで止めるのは、pre-push を無効にする形だけ — それを許すと検査が
  # 素通りになる。
  if [[ $found_push == "1" && $push_bypass == "1" ]]; then
    emit_verdict deny "git push が pre-push hook を無効にする形(--no-verify、または -c core.hooksPath=)になっています。push の検査は pre-push hook で行うため、この形では実行できません。--no-verify と -c core.hooksPath を外して push し直してください。" push-hook-bypass
  fi

  # gh の投稿(ADR-0003): 受理するのは正準形だけ。宛先が PRIVATE/INTERNAL と
  # 分かっている投稿は検査しない(これは「検査しない」という正当な判定)。それ
  # 以外(公開、または宛先を静的に決められない)の投稿が正準形を外れていれば
  # deny。正準形なら、コマンド文字列と本文ファイルを denylist と照合する。
  # 本文ファイルを読めないときは、読めた範囲だけで pass せず ask にする
  # (fail-loud、#55)。
  local repo vis offset=0 scan_public=0
  local -a scan_bodies=()
  for ((i = 0; i < n_posts; i++)); do
    repo="${post_repo[i]}"
    n="${post_body_n[i]}"
    if [[ -n $repo ]]; then
      vis="$(repo_visibility "$repo")"
      if [[ $vis == PRIVATE || $vis == INTERNAL ]]; then
        offset=$((offset + n))
        continue
      fi
    fi
    if [[ -n ${post_code[i]} ]]; then
      emit_verdict deny "$(noncanonical_reason_text "${post_code[i]}")" gh-noncanonical none "" "${post_code[i]}"
    fi
    scan_public=1
    for ((k = 0; k < n; k++)); do
      scan_bodies+=("${all_bodies[offset + k]}")
    done
    offset=$((offset + n))
  done
  if [[ $scan_public == 1 ]]; then
    # 一致の出所(コマンド文字列か本文ファイルか)を理由文に出すため、本文を足す
    # 前のコマンド側を取っておく(#85)。
    local command_subject="$scan_subject"
    for body_path in "${scan_bodies[@]+"${scan_bodies[@]}"}"; do
      if [[ -f $body_path && -r $body_path ]]; then
        scan_subject+=$'\n'"$(cat -- "$body_path" 2>/dev/null)" || true
      else
        emit_verdict ask "gh の本文の入力元ファイルを読めません: ${body_path}" body-source-unreadable
      fi
    done
    require_orgs_file
    build_patterns
    if match_verdict "$scan_subject"; then
      local v="$VERDICT" c="$MATCH_CLASS" t="$MATCH_TERM" where reason
      # コマンド側だけでも一致するならコマンド文字列中、そうでなければ本文ファイル中。
      if match_verdict "$command_subject"; then
        where="コマンド文字列中"
      else
        where="本文ファイルの中身"
      fi
      reason="$(verdict_reason "$v" "$c") 一致した場所: ${where}。語そのものは bleep explain で確認できます。"
      emit_verdict "$v" "$reason" "$(reason_id_for_verdict "$v" "$c")" "$c" "$t"
    fi
  fi

  exit 0
}

# compute_since_diff_text: $1=since_rev -> "$1..HEAD" 範囲の追加行 + 新規/
# rename 先ファイルパス + commit メッセージを出力する。抽出は push の検査と
# 同じ diff_text_for_range(bleep 内の単一正本、D7)。default branch/
# merge-base の自動解決はしない — audit --since はユーザが明示的に起点を指定する
# 手動操作であり、push の fail-loud 経路(起点を自動解決できなければ ask)とは
# 前提が異なる。範囲を解決できなければ非 0(「[range] 理由文」を stdout に
# 書く)。
compute_since_diff_text() {
  local since="$1" dir="${TARGET_CWD:-.}"
  diff_text_for_range "$dir" "$since"..HEAD
}

audit() {
  local remote=false since=''
  local -a paths=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --remote) remote=true ;;
      --since)
        since="${2-}"
        shift
        ;;
      *) paths+=("$1") ;;
    esac
    shift
  done

  build_patterns
  local hit=0 content

  # --since <rev>: working tree の現物(git ls-files)は「今 push したら
  # 何が漏れるか」しか見ない。private → public 化の直前には、既に削除
  # した内容(過去のコミットにだけ残る denylist 文字列)も含めて履歴全体を
  # 確認したい(G3)。working tree のスキャンを置き換えるのではなく追加する
  # — 両方確認できて初めて「これから公開して大丈夫か」の判断材料になる。
  # match_verdict はグローバル変数 VERDICT で結果を返す(コマンド置換で
  # 囲むと判定レッジャー用の付随変数がサブシェルに閉じてしまうため)。
  if [[ -n $since ]]; then
    local since_text
    if ! since_text="$(compute_since_diff_text "$since")"; then
      printf 'ask: history-since=%s を検査できませんでした: %s\n' "$since" "$since_text"
      hit=1
    elif match_verdict "$since_text"; then
      printf '%s: history-since=%s\n' "$VERDICT" "$since"
      hit=1
    fi
  fi

  if ((${#paths[@]} == 0)); then
    mapfile -t paths < <(git ls-files 2>/dev/null)
  fi
  local f
  for f in "${paths[@]}"; do
    [[ -f $f ]] || continue
    path_allow_suppressed "$f" && continue
    content="$(cat "$f" 2>/dev/null)"
    if match_verdict "$content"; then
      printf '%s: file=%s\n' "$VERDICT" "$f"
      hit=1
    fi
  done

  if [[ $remote == true ]] && command -v "$GH_BIN" > /dev/null 2>&1; then
    local n title body
    while IFS=$'\t' read -r n title body; do
      [[ -n $n ]] || continue
      if match_verdict "$title"$'\n'"$body"; then
        printf '%s: issue=#%s\n' "$VERDICT" "$n"
        hit=1
      fi
    done < <("$GH_BIN" issue list --state open --limit 200 --json number,title,body \
      --jq '.[] | [.number, .title, (.body // "" | gsub("\n";" "))] | @tsv' 2> /dev/null)
    while IFS=$'\t' read -r n title body; do
      [[ -n $n ]] || continue
      if match_verdict "$title"$'\n'"$body"; then
        printf '%s: pr=#%s\n' "$VERDICT" "$n"
        hit=1
      fi
    done < <("$GH_BIN" pr list --state open --limit 200 --json number,title,body \
      --jq '.[] | [.number, .title, (.body // "" | gsub("\n";" "))] | @tsv' 2> /dev/null)
  fi

  if [[ $hit -eq 0 ]]; then
    printf '残存ヒットはありません。\n'
  fi
  return $hit
}

selftest() {
  local tmp
  tmp="$(mktemp -d)"
  TEST_TMP="$tmp"
  trap 'rm -rf "$TEST_TMP"' EXIT

  export BLEEP_CONFIG_DIR="$tmp/config"
  export BLEEP_STATE_DIR="$tmp/state"
  export BLEEP_LEDGER_DIR="$tmp/agent-verdicts"
  export BLEEP_ORGS_FILE="$tmp/config/orgs.txt"
  export BLEEP_REPOS_FILE="$tmp/config/repos.txt"
  export BLEEP_ALLOW_STOPWORDS_FILE="$tmp/config/allow-stopwords.txt"
  export BLEEP_ALLOW_REGEXES_FILE="$tmp/config/allow-regexes.txt"
  export BLEEP_ALLOW_PATHS_FILE="$tmp/config/allow-paths.txt"
  # 実ホストの ~/.config/publish-guard の有無で理由文が変わらないよう固定する
  # (このパスは作らない — 「移行未了」を見るケースだけ別パスを渡す)。
  export BLEEP_LEGACY_CONFIG_DIR="$tmp/legacy-config-absent"
  export BLEEP_OWNER="test-owner"
  init_vars # export しただけでは既に評価済みの変数に反映されないため明示的に再計算する
  mkdir -p "$tmp/config" "$tmp/state"
  printf 'acme\n' > "$BLEEP_ORGS_FILE"
  printf 'acme/secret-project\n' > "$BLEEP_REPOS_FILE"

  # gh をスタブし、private/internal リポ一覧の live 取得を固定内容にする。
  # 実際の呼び出しは常に --jq を付ける(--json nameWithOwner --jq
  # '.[].nameWithOwner' / --json visibility --jq .visibility)ので、
  # スタブも jq 適用後の値を返す。#44: "wren" は長さ4の架空リポ名
  # (CONTRIBUTING の架空名規約、SOFT_MAXLEN=4 の既定値で降格される側の
  # 境界例)。
  cat > "$tmp/bin-gh" <<'STUB'
#!/usr/bin/env bash
# repo list は private/internal どちらの呼び出しでも同じ一覧を返す(重複は
# refresh_private_repo_cache 側の sort -u が畳む)。テストが見たいのは
# 「orgs.txt の org 名だけから private リポ名が導出される」という経路の
# 有無であり、private/internal の呼び分け自体は本体側の実装(--visibility
# を private/internal で2回呼ぶ)でカバーする。
case "$1 $2" in
  "repo list") printf 'test-owner/my-private-tool\ntest-owner/wren\n' ;;
  "repo view") printf 'PUBLIC' ;;
  "api user") printf 'test-owner' ;;
  *) exit 1 ;;
esac
STUB
  chmod +x "$tmp/bin-gh"
  export BLEEP_GH_BIN="$tmp/bin-gh"
  init_vars

  local fails=0
  expect_verdict() { # $1=expected(deny/ask/pass) $2=text
    local got
    build_patterns
    if match_verdict "$2"; then got="$VERDICT"; else got="pass"; fi
    if [[ $got != "$1" ]]; then
      echo "FAIL(期待=$1, 実際=$got): $2" >&2
      fails=$((fails + 1))
    fi
  }

  # hard-deny: org/repo 形式(URL に埋め込まれていても)
  expect_verdict deny "参照: acme/secret-project の話"
  expect_verdict deny "https://github.com/acme/secret-project/issues/1"
  # hard-deny: repos.txt の裸のリポ名単体
  expect_verdict deny "secret-project の CI が壊れている"
  # hard-deny: 自分の private リポ名(live 取得したキャッシュ)
  expect_verdict deny "my-private-tool のドリフトを見つけた"
  # ask: org 名の裸の単体出現(スラッシュ無し)
  expect_verdict ask "会社は acme という名前です"
  expect_verdict ask "user@acmecorp.example のような紛らわしいドメインではなく単語一致 acme のみ"
  # pass: 無関係
  expect_verdict pass "これは無関係な文章です"
  expect_verdict pass "academia という単語だけの文章"

  # explain(#44): レッジャーの term_hash から現在の denylist の一致語を
  # 平文で復元できること。判定エンジン(match_verdict)には触れないので
  # build_patterns の呼び直しだけで検証できる。
  local explain_out explain_hash
  explain_hash="$(term_hash secret-project)"
  explain_out="$(cmd_explain "$explain_hash")"
  [[ $explain_out == $'word-hard\tsecret-project' ]] || {
    echo "FAIL(explain: word-hard 一致): out=[$explain_out]" >&2
    fails=$((fails + 1))
  }
  explain_out="$(cmd_explain "$(term_hash acme)")"
  [[ $explain_out == $'word-warn\tacme' ]] || {
    echo "FAIL(explain: word-warn 一致): out=[$explain_out]" >&2
    fails=$((fails + 1))
  }
  if cmd_explain "$(term_hash no-such-term-xyz)" > /dev/null 2>&1; then
    echo "FAIL(explain: 未知の hash は非 0 を返すべき)" >&2
    fails=$((fails + 1))
  fi
  if cmd_explain 'not-a-hash' > /dev/null 2>&1; then
    echo "FAIL(explain: hex64 でない引数は非 0 を返すべき)" >&2
    fails=$((fails + 1))
  fi

  # #44: WORD_HARD のうち長さ ≤ SOFT_MAXLEN(既定4)の裸名は WORD_SOFT
  # (ask)へ降格し、live sweep 由来の owner が分かれば "owner/name" 形を
  # NWO_HARD(hard-deny)へ足して recall を補う。"wren" は長さ4の架空
  # private リポ名(gh スタブが test-owner/wren を返す)。
  expect_verdict ask "wren の話"
  expect_verdict deny "test-owner/wren の話" # NWO_HARD が recall を補う
  expect_verdict pass "test-owner/wren-app" # ハイフン複合語は非境界(#35 と同じ規律)
  explain_out="$(cmd_explain "$(term_hash wren)")"
  [[ $explain_out == $'word-soft\twren' ]] || {
    echo "FAIL(explain: word-soft 一致): out=[$explain_out]" >&2
    fails=$((fails + 1))
  }
  explain_out="$(cmd_explain "$(term_hash test-owner/wren)")"
  [[ $explain_out == $'plain\ttest-owner/wren' ]] || {
    echo "FAIL(explain: NWO_HARD 一致(match_class=plain)): out=[$explain_out]" >&2
    fails=$((fails + 1))
  }

  # allow-stopwords は WORD_SOFT にも及ぶ(WORD_HARD からの分岐元と同じ配列
  # を降格前にフィルタしているため)。
  printf 'wren\n' > "$BLEEP_ALLOW_STOPWORDS_FILE"
  expect_verdict pass "wren の話"
  expect_verdict pass "test-owner/wren の話"
  : > "$BLEEP_ALLOW_STOPWORDS_FILE"

  # allow-regexes は word-soft の ask も抑止できる(WORD_WARN と同じ経路)。
  printf 'wren の話ではない\n' > "$BLEEP_ALLOW_REGEXES_FILE"
  expect_verdict pass "wren の話ではない、別件だ"
  expect_verdict ask "wren の話" # 抑止対象外の文では引き続き ask
  : > "$BLEEP_ALLOW_REGEXES_FILE"

  # BLEEP_SOFT_MAXLEN=0 は降格を無効化し、#46 までの挙動(裸名は常に
  # hard-deny)に戻す。init_vars が読む env var なので外部プロセスで検証する。
  set +e
  out="$(BLEEP_SOFT_MAXLEN=0 "$SELF" scan <<< "wren の話" 2>&1)"
  rc=$?
  set -e
  [[ $rc -eq 2 ]] || { echo "FAIL(BLEEP_SOFT_MAXLEN=0 で降格無効): rc=$rc out=$out" >&2; fails=$((fails + 1)); }

  # 旧形式(裸名のみ)キャッシュを置いても、次回参照時に TTL 無視で
  # 自動再取得され owner/name 形に復元される(#44 D5)。
  printf 'my-private-tool\n' > "$PRIVATE_CACHE"
  build_patterns
  if [[ -f $PRIVATE_CACHE ]] && grep -qv '/' "$PRIVATE_CACHE"; then
    echo "FAIL(旧形式 cache が owner/name 形に再取得されていない): $(cat "$PRIVATE_CACHE")" >&2
    fails=$((fails + 1))
  fi

  # 改行直後の単語境界(adapter が tool_input を丸ごと文字列化するときの
  # 回帰 — 実改行であれば単語境界は正しく機能する。adapter 側のテスト
  # (hooks/claude-adapter に付く selftest)で、JSON エスケープ由来の
  # "\n"(バックスラッシュ+n)がここを壊さないことを別途確認する)。
  expect_verdict deny "見つけた件
secret-project は失敗した"
  expect_verdict ask "検討メモ
acme で議論した"

  # allow-stopwords: 組み込みの .github は既定で denylist に入らない
  printf 'acme/.github\n' > "$BLEEP_REPOS_FILE"
  expect_verdict pass ".github の workflows を見た"
  printf 'acme/secret-project\n' > "$BLEEP_REPOS_FILE"

  # #15: allow-stopwords は live sweep 由来の private リポ名(WORD_HARD)も
  # 外す。個人 owner の owner/repo 形は元々 PLAIN_PATTERNS に入らない
  # (org/repo 形の PLAIN_PATTERNS は orgs.txt/repos.txt 由来のみ)ため、
  # bare 名を stopword すれば owner/repo 形も通る(README「Marking a
  # private repo as "prospectively public"」参照)。一方、orgs.txt 配下の
  # org/repo は PLAIN_PATTERNS がフィルタされないため引き続き deny する
  # 非対称を固定する。
  printf '# prospectively public\nmy-private-tool\n' > "$BLEEP_ALLOW_STOPWORDS_FILE"
  expect_verdict pass "my-private-tool のドリフトを見つけた"
  expect_verdict pass "test-owner/my-private-tool のドリフトを見つけた"
  expect_verdict deny "acme/secret-project の話" # org 配下は引き続き deny
  : > "$BLEEP_ALLOW_STOPWORDS_FILE"

  # allow-stopwords: ユーザ定義の追加 stopword
  printf 'widget\n' > "$BLEEP_ALLOW_STOPWORDS_FILE"
  printf 'acme/widget\n' >> "$BLEEP_REPOS_FILE"
  expect_verdict pass "widget の話"
  : > "$BLEEP_ALLOW_STOPWORDS_FILE"
  printf 'acme/secret-project\n' > "$BLEEP_REPOS_FILE"

  # #35: 単語境界は拡張子(`.` + 英数字)と `-` を非境界とする。private
  # リポ名が一般語1語(例: "gizmo")のとき、無関係な公開リポの拡張子
  # 付きファイル名や複合語まで誤って単語一致しないこと。
  printf 'acme/gizmo\n' >> "$BLEEP_REPOS_FILE"
  expect_verdict pass "gizmo.json を更新した" # 拡張子は非境界
  expect_verdict pass "app-gizmo の設定" # ハイフン複合語(前)は非境界
  expect_verdict pass "gizmo-app の設定" # ハイフン複合語(後)は非境界
  expect_verdict deny "see gizmo." # 文末のドットは引き続き一致
  expect_verdict deny "gizmo の話" # 裸の単語一致は変わらず deny
  printf 'acme/secret-project\n' > "$BLEEP_REPOS_FILE"

  # allow-regexes: ask だけを無効化する(deny は緩めない)
  printf 'acme-forum\\.example' > "$BLEEP_ALLOW_REGEXES_FILE"
  expect_verdict pass "問い合わせは acme-forum.example の acme 宛"
  : > "$BLEEP_ALLOW_REGEXES_FILE"

  # ---- 判定レッジャー ------------------------------------------------------
  local ledger_line
  rm -rf "$BLEEP_LEDGER_DIR"
  set +e
  (BLEEP_HOST=claude BLEEP_SESSION_ID=sess-1 BLEEP_TOOL_NAME=Bash "$SELF" scan <<< "acme/secret-project の件") > /dev/null 2>&1
  set -e
  if [[ ! -f "$BLEEP_LEDGER_DIR/bleep.jsonl" ]]; then
    echo "FAIL(ledger: deny で1行書かれるはず): ファイルが無い" >&2
    fails=$((fails + 1))
  else
    ledger_line="$(tail -n1 "$BLEEP_LEDGER_DIR/bleep.jsonl")"
    local want
    for want in '"verdict":"deny"' '"reason_id":"repo-ref"' '"match_class":"plain"' \
      '"host":"claude"' '"session_id":"sess-1"' '"tool_name":"Bash"' '"repo":"tarotene/bleep"'; do
      [[ $ledger_line == *"$want"* ]] || { echo "FAIL(ledger: $want が無い): $ledger_line" >&2; fails=$((fails + 1)); }
    done
    if [[ $ledger_line == *"acme/secret-project"* ]]; then
      echo "FAIL(ledger: 平文のマッチ語が書かれている): $ledger_line" >&2
      fails=$((fails + 1))
    fi
    if [[ "$(wc -l < "$BLEEP_LEDGER_DIR/bleep.jsonl")" -ne 1 ]]; then
      echo "FAIL(ledger: 1回の deny で1行のはず): $(cat "$BLEEP_LEDGER_DIR/bleep.jsonl")" >&2
      fails=$((fails + 1))
    fi
  fi

  # pass では書かない。
  rm -rf "$BLEEP_LEDGER_DIR"
  set +e
  (BLEEP_HOST=claude "$SELF" scan <<< "これは無関係な文章です") > /dev/null 2>&1
  set -e
  if [[ -f "$BLEEP_LEDGER_DIR/bleep.jsonl" ]]; then
    echo "FAIL(ledger: pass で書かれてはいけない): $(cat "$BLEEP_LEDGER_DIR/bleep.jsonl")" >&2
    fails=$((fails + 1))
  fi

  # DO_NOT_TRACK / BLEEP_NO_LEDGER で無効化できる。
  rm -rf "$BLEEP_LEDGER_DIR"
  set +e
  (DO_NOT_TRACK=1 "$SELF" scan <<< "acme/secret-project の件") > /dev/null 2>&1
  set -e
  [[ -f "$BLEEP_LEDGER_DIR/bleep.jsonl" ]] && { echo "FAIL(ledger: DO_NOT_TRACK=1 で書かれてはいけない)" >&2; fails=$((fails + 1)); }
  rm -rf "$BLEEP_LEDGER_DIR"
  set +e
