# cmd_doctor: 導入の健全性の最小検査(#56 提案3、docs/adr/0002-gh-intent-and-layers.md)。
# 合成した denylist で実コマンドに canary を通す検査は後続。
cmd_doctor() {
  local fail=0 proto hj
  doctor_ok() { printf 'ok: %s\n' "$1"; }
  doctor_ng() { printf 'NG: %s\n' "$1"; fail=1; }

  if proto="$("$LEX_BIN" --protocol 2>/dev/null)"; then
    doctor_ok "bleep-hook を実行できる (${LEX_BIN})"
    if [[ $proto == "$LEX_PROTOCOL" ]]; then
      doctor_ok "lex 出力形式の版が一致している (${proto})"
    else
      doctor_ng "lex 出力形式の版が一致しない: bleep 本体=${LEX_PROTOCOL} bleep-hook=${proto:-空}(同じ版に揃えてください)"
    fi
  else
    doctor_ng "bleep-hook を実行できない (${LEX_BIN})。PATH か BLEEP_LEX_BIN を確認してください"
  fi

  # push の検査は git の pre-push が担う(ADR-0003)。PreToolUse は push の中身を
  # 見ないので、pre-push が配線されていなければ push は無検査になる。
  local hp ph
  hp="$(git config --get core.hooksPath 2>/dev/null || true)"
  if [[ -n $hp ]]; then
    hp="${hp/#\~/$HOME}"
  else
    hp="$(git rev-parse --git-path hooks 2>/dev/null || true)"
  fi
  ph="${BLEEP_PRE_PUSH_HOOK:-$hp/pre-push}"
  if [[ -x $ph ]]; then
    if grep -q -- 'scan-push --pre-push' "$ph" 2>/dev/null; then
      doctor_ok "pre-push hook が scan-push --pre-push を呼んでいる (${ph})"
    else
      doctor_ng "pre-push hook が scan-push --pre-push を呼んでいない (${ph})。git が渡す stdin を --pre-push に引き継ぐ配線にしてください(hooks/pre-push 参照)"
    fi
  else
    doctor_ng "pre-push hook が見つからない (${ph})。core.hooksPath か .git/hooks/ に hooks/pre-push を置いてください(置かないと push は無検査です)"
  fi

  hj="${BLEEP_HOOKS_JSON:-$(dirname "$SELF")/hooks/hooks.json}"
  if [[ -f $hj ]]; then
    if grep -Eq '"matcher"[[:space:]]*:[[:space:]]*"[^"]*Bash' "$hj"; then
      doctor_ok "hooks.json の matcher が Bash を覆っている (${hj})"
    else
      doctor_ng "hooks.json の matcher が Bash を覆っていない (${hj})"
    fi
    if grep -Eq '"matcher"[[:space:]]*:[[:space:]]*"[^"]*mcp__' "$hj"; then
      doctor_ok "hooks.json の matcher が MCP (mcp__) を覆っている"
    else
      doctor_ng "hooks.json の matcher が MCP (mcp__) を覆っていない (${hj})"
    fi
  else
    printf 'skip: hooks.json が見つからない (%s)。hook の登録は検査していません(BLEEP_HOOKS_JSON で指定できます)\n' "$hj"
  fi

  [[ $fail -eq 0 ]] || exit 1
}

# ---- --cwd グローバルオプション --------------------------------------------
# ALLOW チェックとサブコマンド dispatch はどちらも "${1-}" でサブコマンド名を
# 見るため、--cwd はその判定より前に剥がす。TARGET_CWD は resolve_repo_nwo/
# compute_push_diff_text/resolve_default_branch が `git -C` で参照する
# (#10/#14 の第一段 — 実効ディレクトリを cd 追跡で解決するのは段2)。
if [[ "${1-}" == "--cwd" && -n "${2-}" ]]; then
  TARGET_CWD="$2"
  shift 2
elif [[ "${1-}" == "--cwd" ]]; then
  usage >&2
  exit 2
fi

# ---- dispatch ---------------------------------------------------------------

if [[ "${BLEEP_ALLOW:-}" == "1" ]]; then
  case "${1-}" in
    scan | scan-push | scan-bash-command) exit 0 ;;
  esac
fi

case "${1-}" in
  scan)
    shift
    cmd_scan "$@"
    ;;
  scan-push)
    shift
    cmd_scan_push "$@"
    ;;
  scan-bash-command)
    shift
    cmd_scan_bash_command "$@"
    ;;
  audit)
    shift
    audit "$@"
    ;;
  explain)
    shift
    cmd_explain "$@"
    ;;
  doctor) cmd_doctor ;;
  refresh-cache)
    refresh_private_repo_cache && printf 'private-repos-cache.txt を更新しました。\n' || printf 'キャッシュ更新に失敗しました(gh の認証状態を確認してください)。\n' >&2
    ;;
  selftest) selftest ;;
  -h | --help) usage ;;
  "")
    usage >&2
    exit 2
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
