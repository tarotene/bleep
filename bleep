  rc=$?
  set -e
  [[ $rc -eq 0 ]] || { echo "FAIL(#9: cd パスの private リポ名だけでは deny しない): 期待=0(pass) 実際=$rc" >&2; fails=$((fails + 1)); }

  # 引用符の中の && は分割対象にならないこと(素朴な分割が引用文字列を
  # 切って deny を取りこぼす回帰の固定)。
  set +e
  "$SELF" scan-bash-command 'gh pr create --title t --body "before && my-private-tool after"' > /dev/null 2>&1
  rc=$?
  set -e
  [[ $rc -eq 2 ]] || { echo "FAIL(引用符内の && で分割しない): 期待=2(deny) 実際=$rc" >&2; fails=$((fails + 1)); }

  # #22 の回帰1: 二重引用符内の \" が quote 状態を誤って閉じ、後続の && が
  # 区切りとして認識されず gh pr create セグメントごと無検査 pass していた
  # (split_command_segments のバックスラッシュエスケープ未対応)。
  set +e
  "$SELF" scan-bash-command 'echo \" && gh pr create --title t --body "acme/secret-project"' > /dev/null 2>&1
  rc=$?
  set -e
  [[ $rc -eq 2 ]] || { echo "FAIL(#22: \\\" で && の区切りが壊れない): 期待=2(deny) 実際=$rc" >&2; fails=$((fails + 1)); }

  # #22 の回帰2: --repo の値に \" を含むと tokenize_segment が quote を早期に
  # 閉じ、gh_publish への分類自体に失敗して無検査 pass していた
  # (tokenize_segment のバックスラッシュエスケープ未対応)。
  set +e
  "$SELF" scan-bash-command 'gh --repo "x\"y" pr create --title t --body "acme/secret-project leak"' > /dev/null 2>&1
  rc=$?
  set -e
  [[ $rc -eq 2 ]] || { echo "FAIL(#22: --repo 値の \\\" で分類が壊れない): 期待=2(deny) 実際=$rc" >&2; fails=$((fails + 1)); }

  # 複数 cd(#14 の裁定): 先頭の cd だけでなく、直前までの全 cd を反映する
  # こと。先頭だけ見ると PRIVATE な repo_priv に誤解決して検査全体を
  # スキップしてしまう(rc=0)。正しくは最後の cd(PUBLIC な repo_pub)を
  # 反映し、body の denylist 文字列を検査して deny する。
  local repo_priv="$tmp/repo_priv" repo_pub="$tmp/repo_pub" d
  for d in "$repo_priv" "$repo_pub"; do
    mkdir -p "$d"
    git -C "$d" init -qb main
    git -C "$d" config core.hooksPath /dev/null
    git -C "$d" config user.email test@example.invalid
    git -C "$d" config user.name test
    git -C "$d" config commit.gpgsign false
    echo x > "$d/f.txt"
    git -C "$d" add f.txt
    git -C "$d" commit -qm initial
  done
  git -C "$repo_priv" remote add origin "$tmp/remote-priv.git"
  git -C "$repo_pub" remote add origin "$tmp/remote-pub.git"
  cat > "$tmp/bin-gh" <<'STUB'
#!/usr/bin/env bash
case "$1 $2" in
  "repo list") printf 'my-private-tool\n' ;;
  "repo view")
    case "$3" in
      *remote-priv.git) printf 'PRIVATE' ;;
      *) printf 'PUBLIC' ;;
    esac
    ;;
  "api user") printf 'test-owner' ;;
  *) exit 1 ;;
esac
STUB
  rm -f "$BLEEP_STATE_DIR/visibility-cache.tsv"
  set +e
  "$SELF" scan-bash-command "cd $repo_priv && cd $repo_pub && gh pr create --title t --body \"acme/secret-project\"" > /dev/null 2>&1
  rc=$?
  set -e
  [[ $rc -eq 2 ]] || { echo "FAIL(複数 cd: 最後の cd を反映すること): 期待=2(deny) 実際=$rc" >&2; fails=$((fails + 1)); }

  # #9/#14 の組み合わせ: cd のパスに private リポ名を含み、かつ gh 側に
  # --repo で別の PUBLIC リポを明示している場合、visibility は --repo 側で
  # 解決され(cd パスの private リポ名は無関係)、scan subject からも cd
  # セグメントが除かれるので pass する。
  set +e
  "$SELF" scan-bash-command 'cd /x/my-private-tool-work && gh pr create --repo public/other --title t --body b' > /dev/null 2>&1
  rc=$?
  set -e
  [[ $rc -eq 0 ]] || { echo "FAIL(#9+#14: cd の private 名 + --repo public/other): 期待=0(pass) 実際=$rc" >&2; fails=$((fails + 1)); }

  # 変数展開を含む cd は静的には解決できない。無言 pass にはせず、既存の
  # fail-loud 経路(push 差分計算の失敗 = default branch/merge-base が
  # ガラクタなパスでは解けない)を通って ask にエスカレートする。
  set +e
  "$SELF" scan-bash-command 'cd "$D" && git push origin main' > /dev/null 2>&1
  rc=$?
  set -e
  [[ $rc -eq 1 ]] || { echo "FAIL(変数展開を含む cd は ask): 期待=1(ask) 実際=$rc" >&2; fails=$((fails + 1)); }

  # gh の公開面網羅(段3): pr|issue create/edit/comment 以外にも
  # release create/edit・repo edit・gist create・api の書き込みメソッドが
  # 以前はすべてフォールスルーしていた(triage で発見)。
  set +e
  "$SELF" scan-bash-command 'gh release create v1 --notes "acme/secret-project"' > /dev/null 2>&1
  rc=$?
  set -e
  [[ $rc -eq 2 ]] || { echo "FAIL(gh release create): 期待=2(deny) 実際=$rc" >&2; fails=$((fails + 1)); }

  set +e
  "$SELF" scan-bash-command 'gh repo edit --description "acme/secret-project"' > /dev/null 2>&1
  rc=$?
  set -e
  [[ $rc -eq 2 ]] || { echo "FAIL(gh repo edit): 期待=2(deny) 実際=$rc" >&2; fails=$((fails + 1)); }

  set +e
  "$SELF" scan-bash-command 'gh gist create --desc "acme/secret-project" file.txt' > /dev/null 2>&1
  rc=$?
  set -e
  [[ $rc -eq 2 ]] || { echo "FAIL(gh gist create): 期待=2(deny) 実際=$rc" >&2; fails=$((fails + 1)); }

  set +e
  "$SELF" scan-bash-command 'gh api -X POST repos/acme/other/contents/f.txt --raw-field content="acme/secret-project"' > /dev/null 2>&1
  rc=$?
  set -e
  [[ $rc -eq 2 ]] || { echo "FAIL(gh api -X POST): 期待=2(deny) 実際=$rc" >&2; fails=$((fails + 1)); }

  # gh api の読み取り専用メソッド(-X GET 相当、既定)は公開面として扱わない
  # — 検出のみの範囲を無闇に広げない(D9)。
  set +e
  "$SELF" scan-bash-command 'gh api repos/acme/other --jq .name' > /dev/null 2>&1
  rc=$?
  set -e
  [[ $rc -eq 0 ]] || { echo "FAIL(gh api 読み取りは対象外): 期待=0(pass) 実際=$rc" >&2; fails=$((fails + 1)); }

  # PRIVATE な対象リポは検査自体をスキップする(--repo 明示指定)。
  cat > "$tmp/bin-gh" <<'STUB'
#!/usr/bin/env bash
case "$1 $2" in
  "repo list") printf 'my-private-tool\n' ;;
  "repo view") printf 'PRIVATE' ;;
  "api user") printf 'test-owner' ;;
  *) exit 1 ;;
esac
STUB
  rm -f "$BLEEP_STATE_DIR/visibility-cache.tsv"
  set +e
  (cd "$repo" && "$SELF" scan-bash-command 'gh pr create --repo acme/other --title t --body "acme/secret-project"') > /dev/null 2>&1
  rc=$?
  set -e
  [[ $rc -eq 0 ]] || { echo "FAIL: PRIVATE な対象なのに検査された(rc=$rc)" >&2; fails=$((fails + 1)); }

  # fail-loud: merge-base が解けない(origin/HEAD 未設定の新規リポ)場合は
  # 無言 pass ではなく ask にエスカレートする。origin remote 自体を作らない
  # ことで resolve_repo_nwo を意図的に失敗させ(可視性スキップ経路に入らせ
  # ない)、compute_push_diff_text の merge-base 失敗経路まで確実に到達させる
  # — gh はこの時点で PRIVATE を返すスタブに固定済みなので、visibility 経路
  # に入るとテストの意図(diff 計算失敗の検出)を検証できなくなる。
  local repo2="$tmp/repo2"
  mkdir -p "$repo2"
  git -C "$repo2" init -qb main
  git -C "$repo2" config core.hooksPath /dev/null
  git -C "$repo2" config user.email test@example.invalid
  git -C "$repo2" config user.name test
  git -C "$repo2" config commit.gpgsign false
  echo x > "$repo2/a.txt"
  git -C "$repo2" add a.txt
  git -C "$repo2" commit -qm initial
  set +e
  (cd "$repo2" && "$SELF" scan-push) > /dev/null 2>&1
  rc=$?
  set -e
  [[ $rc -eq 1 ]] || { echo "FAIL(fail-loud merge-base): 期待=1(ask) 実際=$rc" >&2; fails=$((fails + 1)); }

  # audit --since REV(G3): working tree の現物(git ls-files)では見えない、
  # 既に削除済みだが過去のコミットに残る denylist 文字列を検出できること。
  local repo8="$tmp/repo8"
  mkdir -p "$repo8"
  git -C "$repo8" init -qb main
  git -C "$repo8" config core.hooksPath /dev/null
  git -C "$repo8" config user.email test@example.invalid
  git -C "$repo8" config user.name test
  git -C "$repo8" config commit.gpgsign false
  echo "line0" > "$repo8/f.txt"
  git -C "$repo8" add f.txt
  git -C "$repo8" commit -qm initial
  local root8
  root8="$(git -C "$repo8" rev-parse HEAD)"
  printf 'line0\nacme/secret-project\n' > "$repo8/f.txt"
  git -C "$repo8" add f.txt
  git -C "$repo8" commit -qm "add secret mention"
  printf 'line0\n' > "$repo8/f.txt"
  git -C "$repo8" add f.txt
  git -C "$repo8" commit -qm "remove it again"

  # 現物(working tree)だけの audit は既に削除済みなので何も拾わない。
  local out8
  out8="$(cd "$repo8" && "$SELF" audit f.txt 2>&1)"
  [[ $out8 == *'残存ヒットはありません。'* ]] || { echo "FAIL(audit 現物のみ: 削除済みは拾わない想定): out=$out8" >&2; fails=$((fails + 1)); }

  # --since <root コミット> なら履歴内の追加行として拾う(deny を見つけると
  # audit() は非0を返すため set -e を一時解除する)。
  set +e
  out8="$(cd "$repo8" && "$SELF" audit f.txt --since "$root8" 2>&1)"
  set -e
  [[ $out8 == *'deny: history-since='* ]] || { echo "FAIL(audit --since: 履歴内の denylist 文字列を検出できていない): out=$out8" >&2; fails=$((fails + 1)); }

  # orgs.txt 不在は fail-loud(require_orgs_file)。denylist 全体は private
  # キャッシュ(スタブ gh の my-private-tool)で空にならないので、「空なら
  # ask」ではなくファイルの存在そのものを見ていることをここで確かめる。
  local missing_orgs="$tmp/config/orgs-missing.txt" out9
  set +e
  out9="$(BLEEP_ORGS_FILE="$missing_orgs" "$SELF" scan <<< 'hello' 2>&1)"
  rc=$?
  set -e
  [[ $rc -eq 1 && $out9 == *'未設定'* ]] || { echo "FAIL(orgs.txt 不在の scan は ask(未設定)): rc=$rc out=$out9" >&2; fails=$((fails + 1)); }

  mkdir -p "$tmp/legacy-config"
  set +e
  out9="$(BLEEP_ORGS_FILE="$missing_orgs" BLEEP_LEGACY_CONFIG_DIR="$tmp/legacy-config" "$SELF" scan <<< 'hello' 2>&1)"
  rc=$?
  set -e
  [[ $rc -eq 1 && $out9 == *'移行が未了'* ]] || { echo "FAIL(旧設定 dir 残存は ask(移行未了)): rc=$rc out=$out9" >&2; fails=$((fails + 1)); }

  : > "$tmp/config/orgs-empty.txt"
  set +e
  BLEEP_ORGS_FILE="$tmp/config/orgs-empty.txt" "$SELF" scan <<< 'hello' > /dev/null 2>&1
  rc=$?
  set -e
  [[ $rc -eq 0 ]] || { echo "FAIL(空の orgs.txt は明示 opt-out で pass): 期待=0 実際=$rc" >&2; fails=$((fails + 1)); }

  set +e
  BLEEP_ORGS_FILE="$missing_orgs" BLEEP_ALLOW=1 "$SELF" scan <<< 'hello' > /dev/null 2>&1
  rc=$?
  set -e
  [[ $rc -eq 0 ]] || { echo "FAIL(orgs.txt 不在でも BLEEP_ALLOW=1 は bypass): 期待=0 実際=$rc" >&2; fails=$((fails + 1)); }

  set +e
  (cd "$repo" && BLEEP_ORGS_FILE="$missing_orgs" "$SELF" scan-bash-command 'git status') > /dev/null 2>&1
  rc=$?
  set -e
  [[ $rc -eq 0 ]] || { echo "FAIL(orgs.txt 不在でも無関係なコマンドは pass): 期待=0 実際=$rc" >&2; fails=$((fails + 1)); }

  # $repo は上の PRIVATE ケースで可視性が差し替わっている可能性があるため、
  # nwo が解決できない(= 可視性スキップに入らない)非 git ディレクトリで見る。
  mkdir -p "$tmp/not-a-repo"
  set +e
  (cd "$tmp/not-a-repo" && BLEEP_ORGS_FILE="$missing_orgs" "$SELF" scan-bash-command 'gh issue create --title t --body hello') > /dev/null 2>&1
  rc=$?
  set -e
  [[ $rc -eq 1 ]] || { echo "FAIL(orgs.txt 不在の gh issue create は ask): 期待=1 実際=$rc" >&2; fails=$((fails + 1)); }

  if [[ $fails -gt 0 ]]; then
    echo "selftest: ${fails} 件失敗" >&2
    exit 1
  fi
  echo "selftest: OK"
}

# ---- --cwd グローバルオプション --------------------------------------------
# ALLOW チェックとサブコマンド dispatch はどちらも "${1-}" でサブコマンド名を
# 見るため、--cwd はその判定より前に剥がす。TARGET_CWD は resolve_repo_nwo/
# compute_push_diff_text/resolve_default_branch が `git -C` で参照する
# (#10/#14 の第一段 — 実効ディレクトリを cd 追跡で解決するのは段2)。
if [[ "${1-}" == "--cwd" && -n "${2-}" ]]; then
  TARGET_CWD="$2"
  shift 2
elif [[ "${1-}" == "--cwd" ]]; then
  usage >&2
  exit 2
fi

# ---- dispatch ---------------------------------------------------------------

if [[ "${BLEEP_ALLOW:-}" == "1" ]]; then
  case "${1-}" in
    scan | scan-push | scan-bash-command) exit 0 ;;
  esac
fi

case "${1-}" in
  scan)
    shift
    cmd_scan "$@"
    ;;
  scan-push)
    shift
    cmd_scan_push "$@"
    ;;
  scan-bash-command)
    shift
    cmd_scan_bash_command "$@"
    ;;
  audit)
    shift
    audit "$@"
    ;;
  refresh-cache)
    refresh_private_repo_cache && printf 'private-repos-cache.txt を更新しました。\n' || printf 'キャッシュ更新に失敗しました(gh の認証状態を確認してください)。\n' >&2
    ;;
  selftest) selftest ;;
  -h | --help) usage ;;
  "")
    usage >&2
    exit 2
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
