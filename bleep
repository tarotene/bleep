#!/usr/bin/env bash
# bleep — 会社/private リポジトリの実名が PUBLIC な面(git push・
# gh pr/issue の create/edit/comment・任意テキスト)に漏れるのを防ぐための
# エージェント非依存の判定エンジン。
#
# これは security boundary ではない。制約される当事者(エージェント、または
# 手打ちする人間)が github.com に直接ブラウザで打ち込む経路はどう転んでも
# 仲介できないし、hook のタイムアウトや BLEEP_ALLOW=1 で無効化もできる。
# 事故とエージェントの滑りに対するガードレールとして使うこと。詳細は README。
#
# 判定は3段階(exit code で表現):
#   0 = pass  — denylist に一致しない
#   1 = ask   — denylist 上の org 名が裸の単語で単体出現(メールドメイン等の
#               正当な用途と衝突しうるため deny にしない)
#   2 = deny  — "org/repo" 形式(URL も含む)、または denylist に登録された
#               具体的なリポジトリ名の裸の単語一致(ほぼ確実に意図しない漏洩)
# ask/deny では stdout に理由を1行印字する。pass では何も印字しない。
#
# denylist は一切コミットしない(「ツールは公開・データはローカル」原則):
#   $XDG_CONFIG_HOME/bleep/orgs.txt   — 1行1 org 名(手書きが必要なのは
#                                               実質これだけ)。ファイル自体の
#                                               存在が必須 — 無ければ scan* は
#                                               ask(require_orgs_file)。空
#                                               ファイルは明示的な opt-out。
#   $XDG_CONFIG_HOME/bleep/repos.txt  — 1行1 "org/repo"(任意)
#   自分の private/internal リポジトリ名は、orgs.txt に書いた org 名 +
#   (BLEEP_OWNER が空なら `gh api user` で自動導出する)現在の
#   gh 認証ユーザから、各自の credential で live 導出して TTL 付きで
#   キャッシュする。リポジトリ名のリストそのものは誰も持ち運ばない。
#
# 誤検知の受け皿(gitleaks の [[allowlists]] と同型の3軸):
#   $XDG_CONFIG_HOME/bleep/allow-stopwords.txt — 単語単位で denylist
#     から除外する(組み込みで ".github" を既定値として持つ — GitHub の
#     org-wide デフォルト用の特殊リポジトリで、ファイルパスや URL の断片
#     としてどこにでも出現するため)。
#   $XDG_CONFIG_HOME/bleep/allow-regexes.txt   — この正規表現が
#     scan 対象テキストにマッチしたら ask 判定だけを無効化する(deny は
#     無効化しない — 「ほぼ確実に意図しない漏洩」の強さを緩めないため)。
#   $XDG_CONFIG_HOME/bleep/allow-paths.txt      — audit 対象から
#     除外するファイルパスの正規表現。
#
# 縮退(ADR-0005 の binary-existence gating に倣う): fail-loud に寄せている。
# 判定不能を無言の pass にはしない(下記の各関数のコメント参照)。ただし
# hook のタイムアウトで停止した場合はこのプロセス自体が動かないため防げない
# — これは構造的な限界であり README に明記する。
#
# 使い方:
#   bleep scan [FILE]              stdin(既定)または FILE の内容を
#                                           そのまま denylist と突き合わせる。
#                                           MCP tool_input 等、任意のテキスト向け。
#   bleep scan-push                cwd の git リポジトリで、これから
#                                           push する各コミットの追加行
#                                           (+ 新規/rename 先ファイルパス)と
#                                           commit log を検査する。削除行は
#                                           対象外(#7 — 既公開内容の除去は
#                                           新規公開ではない)。対象リポジトリが
#                                           PRIVATE/INTERNAL と判明していれば
#                                           検査自体をスキップする。
#   bleep scan-bash-command CMD     シェルコマンド文字列を検査する。
#                                           CMD を ; && || | 改行で区切った
#                                           セグメントごとに、global option
#                                           (git の -C 等、gh の --repo 等)を
#                                           読み飛ばしてサブコマンド位置を見る
#                                           (#9/#14 — 正規表現の隣接一致では
#                                           "git -C dir push"/"gh --repo x pr
#                                           create" を取りこぼしていた)。
#                                           "gh pr|issue create/edit/comment"
#                                           "gh release create/edit"
#                                           "gh repo edit" "gh gist create"
#                                           "gh api -X POST/PUT/PATCH" の
#                                           いずれかのセグメントが見つかれば、
#                                           CMD 全文
#                                           から "cd <単一トークン>" セグメント
#                                           だけを除いたテキストを検査する
#                                           (#9 — cd のパス引数に private
#                                           リポ名が含まれるだけでは deny
#                                           しない)。"git push" セグメントが
#                                           見つかれば、先行する cd の積み
#                                           重ね(または同セグメントの -C)
#                                           から解決した実効ディレクトリで
#                                           scan-push と同じ diff+log を検査
#                                           する。どちらの形も無ければ
#                                           無検査で pass。
#   bleep audit [path...] [--remote] [--since REV]
#                                           指定ファイル(省略時は git ls-files
#                                           全体)を同じ denylist で検査する。
#                                           --remote で open な Issue/PR の
#                                           title/body も対象に含める。
#                                           --since REV で "REV..HEAD" の
#                                           追加行/新規ファイルパス/commit
#                                           メッセージも追加で検査する
#                                           (working tree の現物では見えない、
#                                           過去に削除済みの denylist 文字列を
#                                           含む — private → public 化の直前に
#                                           使う)。
#   bleep refresh-cache            private/internal リポジトリ一覧
#                                           キャッシュを強制更新する。
#   bleep selftest                 回帰テスト(スタブ gh/git)。
set -euo pipefail

# bash 本体と Cargo.toml の [package].version を揃える。判定レッジャーの
# tool_version フィールドにだけ使う — bump を忘れても実害は小さい(dotfiles
# 側の集約は tool_version を fingerprint に使わない)。
BLEEP_VERSION='0.2.0'

SELF="$(realpath "$0")"
TEST_TMP=''
TARGET_CWD='' # --cwd で明示された対象ディレクトリ(#10/#14 対応)。空なら "." 扱い。

# init_vars: env から派生変数を(再)計算する。selftest が env を export した
# 「後」に呼び直せるよう関数化してある — トップレベルで一度だけ計算すると、
# selftest 内で export した値が既に評価済みの変数に反映されない。
init_vars() {
  CONFIG_DIR="${BLEEP_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/bleep}"
  # 改名前(publish-guard)の設定ディレクトリ。読みはしない(互換 shim は
  # 持たない、README 参照)— require_orgs_file の理由文を「移行未了」に
  # 切り替えるためだけに存在を見る。
  LEGACY_CONFIG_DIR="${BLEEP_LEGACY_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/publish-guard}"
  STATE_DIR="${BLEEP_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/bleep}"
  ORGS_FILE="${BLEEP_ORGS_FILE:-$CONFIG_DIR/orgs.txt}"
  REPOS_FILE="${BLEEP_REPOS_FILE:-$CONFIG_DIR/repos.txt}"
  ALLOW_STOPWORDS_FILE="${BLEEP_ALLOW_STOPWORDS_FILE:-$CONFIG_DIR/allow-stopwords.txt}"
  ALLOW_REGEXES_FILE="${BLEEP_ALLOW_REGEXES_FILE:-$CONFIG_DIR/allow-regexes.txt}"
  ALLOW_PATHS_FILE="${BLEEP_ALLOW_PATHS_FILE:-$CONFIG_DIR/allow-paths.txt}"
  OWNER="${BLEEP_OWNER:-}"
  GH_BIN="${BLEEP_GH_BIN:-gh}"
  LEX_BIN="${BLEEP_LEX_BIN:-bleep-hook}" # cmd_scan_bash_command の字句解析(D1)
  CACHE_TTL="${BLEEP_CACHE_TTL:-86400}"
  PRIVATE_CACHE="$STATE_DIR/private-repos-cache.txt"
  VIS_CACHE="$STATE_DIR/visibility-cache.tsv"
  OWNER_CACHE="$STATE_DIR/owner-login-cache.txt"
  # 判定レッジャー(ローカルのみ、送信しない)。契約(場所・レコード形)の
  # 正本は tarotene/dotfiles の ADR + docs/schemas/agent-verdict.schema.json
  # (README「判定レッジャー」参照)。ツール名(agent-verdicts/<tool>.jsonl の
  # <tool>)は bleep 固定 — 複数ツールが同じ鍵で書けるよう、ディレクトリと
  # 鍵ファイルはツール横断で共有する。
  LEDGER_DIR="${BLEEP_LEDGER_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/agent-verdicts}"
  LEDGER_FILE="$LEDGER_DIR/bleep.jsonl"
  LEDGER_KEY_FILE="$LEDGER_DIR/hmac-key"
}
init_vars

usage() {
  cat <<'EOF'
usage: bleep [--cwd DIR] <scan [FILE]|scan-push|scan-bash-command CMD|
                       audit [path...] [--remote] [--since REV]|
                       refresh-cache|selftest>

エージェント非依存の denylist 判定エンジン。scan/scan-push/scan-bash-command
は exit code で判定を返す: 0=pass, 1=ask(理由を stdout に1行), 2=deny(同)。
BLEEP_ALLOW=1 で3つの scan* サブコマンドを意識的に bypass できる
(README にのみ記載 — 判定結果の理由文には出さない)。

--cwd DIR: PreToolUse hook プロセス自身の cwd ではなく DIR を対象リポジトリの
  位置として扱う(resolve_repo_nwo/compute_push_diff_text/resolve_default_branch
  が `git -C DIR` で参照する)。サブコマンド名より前に置くこと。DIR が無効な
  場合の挙動は既存の fail-loud 経路をそのまま使う — push 差分計算(merge-base
  解決)が失敗すれば ask にエスカレートし、nwo 解決だけが失敗する場合は
  private/internal 早期スキップに入れないまま denylist 照合を続ける(#10/#14
  — フックプロセスの cwd への暗黙依存を解消する)。

設定は $XDG_CONFIG_HOME/bleep/ 以下、一切コミットしない:
  orgs.txt / repos.txt / allow-stopwords.txt / allow-regexes.txt / allow-paths.txt
orgs.txt が存在しなければ scan* は ask を返す(空ファイルは明示的な opt-out)。
EOF
}

read_lines() { # $1=file; コメント行・空行を除いて出力。ファイル無しは無出力。
  [[ -f "$1" ]] || return 0
  grep -Ev '^[[:space:]]*(#|$)' "$1"
}

# ---- 判定レッジャー(ローカルのみ、送信しない)------------------------------
#
# 「弾かれ続けている」ことを開発元(tarotene/bleep)にフィードバックする
# 仕組みの捕捉点(tarotene/dotfiles の grill-me セッションで裁定)。判定を
# 下したこの場所以外に単一正本を作れない(PreToolUse hook の deny を他の
# hook に通知するイベントを Claude Code/Codex/Copilot のいずれも持たない
# — Anthropic, Hooks reference, https://code.claude.com/docs/en/hooks)。
#
# 書くもの: verdict/reason_id/match_class と、マッチ語をこのマシン固有の
# ランダム鍵で HMAC-SHA256 したハッシュのみ。書かないもの: コマンド本文・
# tool_input・cwd パス・マッチ語の平文・理由文そのもの — bleep の目的が
# 「これらの値を漏らさないこと」なので、判定レッジャー自身がそれを破っては
# 本末転倒になる。
#
# 既定で有効、マシン外へは一切送信しない。DO_NOT_TRACK(空でない値)または
# BLEEP_NO_LEDGER=1 で無効化できる。書き込みに失敗しても判定結果には影響
# させない(fail-open — 判定エンジンの可用性の方を優先する)。

ledger_enabled() {
  [[ -n "${DO_NOT_TRACK:-}" ]] && return 1
  [[ "${BLEEP_NO_LEDGER:-}" == "1" ]] && return 1
  return 0
}

# term_hash: $1=平文のマッチ語 -> hex64(bleep-hook hash に委ねる。鍵の
# 生成・読み書きも bleep-hook 側の責務 — bash 本体はハッシュアルゴリズムを
# 持たない)。失敗したら空文字列(呼び出し側は term_hash を null として書く)。
term_hash() {
  local term="$1"
  [[ -n "$term" ]] || return 0
  mkdir -p "$LEDGER_DIR" 2>/dev/null || return 0
  "$LEX_BIN" hash --key-file "$LEDGER_KEY_FILE" -- "$term" 2>/dev/null || true
}

# ledger_write: $1=deny|ask $2=reason_id $3=match_class(既定 none)
#               $4=平文のマッチ語(既定空、無ければ term_hash は null)
ledger_write() {
  ledger_enabled || return 0
  local verdict="$1" reason_id="$2" match_class="${3:-none}" term="${4-}"
  local hash="" hash_json="null"
  if [[ -n "$term" ]]; then
    hash="$(term_hash "$term")"
    [[ -n "$hash" ]] && hash_json="\"$hash\""
  fi
  local sid_json="null"
  [[ -n "${BLEEP_SESSION_ID:-}" ]] && sid_json="\"${BLEEP_SESSION_ID}\""
  local ts host_field tool_name_field line
  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  host_field="${BLEEP_HOST:-cli}"
  tool_name_field="${BLEEP_TOOL_NAME:-}"
  line="$(printf '{"v":1,"ts":"%s","tool":"bleep","tool_version":"%s","repo":"tarotene/bleep","host":"%s","session_id":%s,"verdict":"%s","reason_id":"%s","match_class":"%s","term_hash":%s,"tool_name":"%s"}' \
    "$ts" "$BLEEP_VERSION" "$host_field" "$sid_json" "$verdict" "$reason_id" "$match_class" "$hash_json" "$tool_name_field")"
  mkdir -p "$LEDGER_DIR" 2>/dev/null || return 0
  chmod 700 "$LEDGER_DIR" 2>/dev/null || true
  (
    flock 9
    printf '%s\n' "$line" >> "$LEDGER_FILE"
  ) 9>>"$LEDGER_FILE.lock" 2>/dev/null || true
}

# ---- allowlist(gitleaks の [[allowlists]] と同型の3軸)----------------------

DEFAULT_STOPWORDS=(.github)
ALLOW_STOPWORDS=()
ALLOW_REGEXES=()
ALLOW_PATHS=()

load_allowlist() {
  ALLOW_STOPWORDS=("${DEFAULT_STOPWORDS[@]}")
  local w
  while IFS= read -r w; do
    [[ -n $w ]] && ALLOW_STOPWORDS+=("$w")
  done < <(read_lines "$ALLOW_STOPWORDS_FILE")

  ALLOW_REGEXES=()
  while IFS= read -r w; do
    [[ -n $w ]] && ALLOW_REGEXES+=("$w")
  done < <(read_lines "$ALLOW_REGEXES_FILE")

  ALLOW_PATHS=()
  while IFS= read -r w; do
    [[ -n $w ]] && ALLOW_PATHS+=("$w")
  done < <(read_lines "$ALLOW_PATHS_FILE")
}

is_stopword() { # $1=word
  local w
  for w in "${ALLOW_STOPWORDS[@]}"; do
    [[ "$1" == "$w" ]] && return 0
  done
  return 1
}

# filter_stopwords: nameref 経由で配列から ALLOW_STOPWORDS に載っている
# 要素を除く(bash 4.3+ の -n を使う。mapfile/BASH_REMATCH 等、既存コードが
# 既に前提する bash バージョンの範囲内)。
filter_stopwords() { # $1=array の変数名
  local -n arr="$1"
  local -a kept=()
  local w
  for w in "${arr[@]}"; do
    is_stopword "$w" || kept+=("$w")
  done
  arr=("${kept[@]}")
}

# text_allow_suppressed: scan 対象テキスト全体に allow-regexes のいずれかが
# マッチしたら 0 を返す。match_verdict() は ask 判定だけをこれで無効化する
# — deny(org/repo 明示参照・具体リポ名一致)は「ほぼ確実に意図しない漏洩」
# なので、周辺文脈の正規表現一致では緩めない。
text_allow_suppressed() { # $1=text
  local text="$1" re
  ((${#ALLOW_REGEXES[@]} > 0)) || return 1
  for re in "${ALLOW_REGEXES[@]}"; do
    grep -Eq -- "$re" <<< "$text" && return 0
  done
  return 1
}

path_allow_suppressed() { # $1=path
  local path="$1" re
  ((${#ALLOW_PATHS[@]} > 0)) || return 1
  for re in "${ALLOW_PATHS[@]}"; do
    grep -Eq -- "$re" <<< "$path" && return 0
  done
  return 1
}

# ---- org/repo のライブ導出 --------------------------------------------------

# resolve_owner_login: BLEEP_OWNER が空なら、現在の gh 認証ユーザの
# login を `gh api user` から live 導出して TTL 付きでキャッシュする。これで
# 「手書きが必要なのは orgs.txt の org 名だけ」になる — 自分のリポジトリの
# 検査は誰にとっても導入即有効。
resolve_owner_login() {
  if [[ -n $OWNER ]]; then
    printf '%s' "$OWNER"
    return 0
  fi
  local now mtime
  now="$(date +%s)"
  if [[ -f $OWNER_CACHE ]]; then
    mtime="$(stat -c %Y "$OWNER_CACHE" 2>/dev/null || stat -f %m "$OWNER_CACHE" 2>/dev/null || printf 0)"
    if (( now - mtime < CACHE_TTL )); then
      cat "$OWNER_CACHE"
      return 0
    fi
  fi
  local login
  login="$("$GH_BIN" api user --jq .login 2>/dev/null)" || return 1
  [[ -n $login ]] || return 1
  mkdir -p "$STATE_DIR"
  printf '%s' "$login" > "$OWNER_CACHE"
  printf '%s' "$login"
}

# refresh_private_repo_cache: 自分の owner 一件 + orgs.txt に書かれた org 名
# それぞれについて、private と internal(gh repo list の --visibility は
# 単一値しか取らないため2回に分ける)のリポジトリ名を live 取得してキャッシュ
# する(プレーンテキスト、1行1名。jq 不要 — gh の --jq は内蔵の gojq を使う
# ため、ローカル jq バイナリに依存しない)。1件でも取得できれば成功とし、
# 全滅した場合だけ失敗を返す(呼び出し側は古いキャッシュにフォールバック)。
refresh_private_repo_cache() {
  mkdir -p "$STATE_DIR"
  local -a owners=()
  local owner org
  owner="$(resolve_owner_login)" && [[ -n $owner ]] && owners+=("$owner")
  while IFS= read -r org; do
    [[ -n $org ]] || continue
    owners+=("$org")
  done < <(read_lines "$ORGS_FILE")
  ((${#owners[@]} > 0)) || return 1

  local tmp got_any=false o vis names
  tmp="$(mktemp "$STATE_DIR/private-repos-cache.txt.XXXXXX")"
  : > "$tmp"
  for o in "${owners[@]}"; do
    for vis in private internal; do
      if names="$("$GH_BIN" repo list "$o" --visibility "$vis" --limit 500 --json name --jq '.[].name' 2>/dev/null)"; then
        [[ -n $names ]] && { printf '%s\n' "$names" >> "$tmp"; got_any=true; }
      fi
    done
  done
  if [[ $got_any == true ]]; then
    sort -u "$tmp" -o "$tmp"
    mv "$tmp" "$PRIVATE_CACHE"
    return 0
  fi
  rm -f "$tmp"
  return 1
}

# private_repo_names: キャッシュが TTL 内ならそれを、無ければ live 取得して
# 出力する。live 取得に失敗し、古いキャッシュも無ければ何も出力しない
# (denylist が空になるだけで、検査自体は他の denylist で継続する — orgs.txt/
# repos.txt が空でなければそれらは引き続き効く)。
private_repo_names() {
  local now mtime
  now="$(date +%s)"
  if [[ -f $PRIVATE_CACHE ]]; then
    mtime="$(stat -c %Y "$PRIVATE_CACHE" 2>/dev/null || stat -f %m "$PRIVATE_CACHE" 2>/dev/null || printf 0)"
    if (( now - mtime < CACHE_TTL )); then
      cat "$PRIVATE_CACHE"
      return 0
    fi
  fi
  refresh_private_repo_cache || true
  [[ -f $PRIVATE_CACHE ]] && cat "$PRIVATE_CACHE"
  return 0
}

# ---- denylist パターン構築 + 判定 ------------------------------------------

# build_patterns: denylist 3種を集めて3つのパターン配列をグローバル変数に積み、
# allow-stopwords で WORD_HARD/WORD_WARN をフィルタする。
#   PLAIN_PATTERNS  — スラッシュを含む固定文字列。-w は使わない(末尾が "/" の
#                     パターンは -w だと理論上一致し得ない — \> は直前の文字が
#                     word 文字であることを要求するため、"/" 終端では常に不成立)。
#                     stopwords は適用しない — "org/repo" 形の明示参照は
#                     単語単体より曖昧性が無いため。
#   WORD_HARD       — 裸のリポ名(単語境界一致、hard-deny)。
#   WORD_WARN       — 裸の org 名(単語境界一致、ask)。
PLAIN_PATTERNS=()
WORD_HARD=()
WORD_WARN=()
build_patterns() {
  PLAIN_PATTERNS=() WORD_HARD=() WORD_WARN=()
  local org nwo repo
  while IFS= read -r org; do
    [[ -n $org ]] || continue
    PLAIN_PATTERNS+=("${org}/")
    WORD_WARN+=("$org")
  done < <(read_lines "$ORGS_FILE")

  while IFS= read -r nwo; do
    [[ -n $nwo ]] || continue
    PLAIN_PATTERNS+=("$nwo")
    repo="${nwo#*/}"
    [[ -n $repo && $repo != "$nwo" ]] && WORD_HARD+=("$repo")
  done < <(read_lines "$REPOS_FILE")

  while IFS= read -r repo; do
    [[ -n $repo ]] || continue
    WORD_HARD+=("$repo")
  done < <(private_repo_names)

  load_allowlist
  filter_stopwords WORD_HARD
  filter_stopwords WORD_WARN
}

# match_verdict: $1 の中身を denylist と突き合わせ、一致すれば 0 を返す。
# 一致しなければ非 0 を返す(何も印字しない)。判定結果はグローバル変数
# VERDICT(deny/ask)に、判定レッジャー用の付随情報は MATCH_CLASS/
# MATCH_TERM(マッチしたパターンの種別と実際のマッチ語、平文)にセットする。
# 呼び出し側は `$(match_verdict ...)` のようにコマンド置換で囲んではならない
# — サブシェルで実行されるとこれらのグローバル変数への代入が親シェルに
# 反映されない。必ず `if match_verdict "$text"; then ...` の形で直接呼ぶ。
# MATCH_CLASS/MATCH_TERM の抽出は既存の -q 判定条件が真になった後に追加の
# grep -o で行うため、判定結果(VERDICT)への影響はない。呼び出し側は
# MATCH_TERM をレッジャーに書く前に必ずハッシュ化すること(平文のまま
# 書いてはいけない)。
VERDICT=''
MATCH_CLASS=''
MATCH_TERM=''
match_verdict() {
  local text="$1"
  VERDICT='' MATCH_CLASS='' MATCH_TERM=''
  if ((${#PLAIN_PATTERNS[@]} > 0)) && grep -Fqf <(printf '%s\n' "${PLAIN_PATTERNS[@]}") <<< "$text"; then
    MATCH_CLASS='plain'
    MATCH_TERM="$(grep -Fof <(printf '%s\n' "${PLAIN_PATTERNS[@]}") <<< "$text" | head -n1 || true)"
    VERDICT='deny'
    return 0
  fi
  if ((${#WORD_HARD[@]} > 0)) && grep -Fwqf <(printf '%s\n' "${WORD_HARD[@]}") <<< "$text"; then
    MATCH_CLASS='word-hard'
    MATCH_TERM="$(grep -Fwof <(printf '%s\n' "${WORD_HARD[@]}") <<< "$text" | head -n1 || true)"
    VERDICT='deny'
    return 0
  fi
  if ((${#WORD_WARN[@]} > 0)) && grep -Fwqf <(printf '%s\n' "${WORD_WARN[@]}") <<< "$text"; then
    text_allow_suppressed "$text" && return 1
    MATCH_CLASS='word-warn'
    MATCH_TERM="$(grep -Fwof <(printf '%s\n' "${WORD_WARN[@]}") <<< "$text" | head -n1 || true)"
    VERDICT='ask'
    return 0
  fi
  return 1
}

verdict_reason() { # $1=deny|ask -> 理由文(bypass 手段はここに書かない。README 参照)
  case "$1" in
    deny) printf 'denylist に登録された company/private リポジトリの参照と一致しました。' ;;
    ask) printf 'denylist に登録された org 名の裸の単体出現と一致しました。正当な用途(例: メールドメイン)か確認してください。' ;;
  esac
}

# match_verdict の結果から reason_id(判定レッジャーの閉語彙)を決める。
reason_id_for_verdict() { # $1=deny|ask
  case "$1" in
    deny) printf 'repo-ref' ;;
    ask) printf 'org-bare' ;;
  esac
}

# emit_verdict: $1=deny|ask $2=reason(理由文) $3=reason_id
#               $4=match_class(既定 none) $5=平文のマッチ語(既定空)
# レッジャーに書いてから理由を印字し、対応する exit code で終了する。
emit_verdict() {
  local verdict="$1" reason="$2" reason_id="$3" match_class="${4:-none}" term="${5-}"
  ledger_write "$verdict" "$reason_id" "$match_class" "$term"
  printf '%s\n' "$reason"
  case "$verdict" in
    deny) exit 2 ;;
    ask) exit 1 ;;
  esac
}

# require_orgs_file: orgs.txt が存在しなければ ask で終了する(fail-loud)。
# read_lines は「ファイル無し = 無出力」なので、orgs.txt が無いホストでは
# org 由来の denylist が黙って空になる。しかも denylist 全体は空にならない
# (private キャッシュは gh 認証ユーザ自身の private リポからも導出される)
# ため、「denylist が空なら ask」では検出できない — 設定ファイルの存在
# そのものを前提条件にする。空ファイルは「org を登録しない」という明示的な
# 選択として従来どおり通す。publish 系の検査経路(cmd_scan / cmd_scan_push /
# cmd_scan_bash_command の gh 分岐)でだけ呼ぶ — git status 等の無関係な
# コマンドは従来どおり pass させる。
require_orgs_file() {
  [[ -f $ORGS_FILE ]] && return 0
  if [[ -d $LEGACY_CONFIG_DIR ]]; then
    emit_verdict ask "bleep の設定が改名前の場所に残っています(${LEGACY_CONFIG_DIR} → ${CONFIG_DIR} への移行が未了)。org denylist が読まれていません。README の Upgrading 手順で移行してください。" legacy-config
  fi
  emit_verdict ask "bleep が未設定です(${ORGS_FILE} がありません)。org denylist が空のまま公開面を検査しています。org 名を 1 行書くか、登録しないなら空ファイルを置いて明示してください。" unconfigured
}

# ---- push 差分 / リポジトリ可視性 ------------------------------------------

# resolve_default_branch: scripts/git-audit-worktrees(dotfiles)の同名関数と
# 同じ idiom。TARGET_CWD(--cwd)が空なら "." = 呼び出しプロセスの cwd。
resolve_default_branch() {
  local dir="${TARGET_CWD:-.}"
  local ref b
  ref="$(git -C "$dir" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null)" || ref=""
  if [[ -n $ref ]]; then
    printf '%s' "${ref#origin/}"
    return 0
  fi
  for b in main master; do
    git -C "$dir" show-ref --verify --quiet "refs/heads/$b" && { printf '%s' "$b"; return 0; }
  done
  printf ''
}

# compute_push_diff_text: これから push する範囲の「追加行」+ 新規/rename 先
# ファイルパス + コミットメッセージを連結して出力する(#7 — 削除行は既公開
# 内容の除去であり新規公開ではないため検査対象外)。default branch /
# merge-base が解決できない場合は非 0 を返し、PUSH_DIFF_FAIL_REASON に理由を
# セットする(fail-loud — 呼び出し側はこれを ask にエスカレートする。無言の
# pass にはしない)。
PUSH_DIFF_FAIL_REASON=''
compute_push_diff_text() {
  PUSH_DIFF_FAIL_REASON=''
  local dir="${TARGET_CWD:-.}"
  local default_branch base
  default_branch="$(resolve_default_branch)"
  if [[ -z $default_branch ]]; then
    PUSH_DIFF_FAIL_REASON='default branch を解決できませんでした(origin/HEAD 未設定・main/master 不在)。'
    return 1
  fi
  base="$(git -C "$dir" merge-base HEAD "origin/$default_branch" 2>/dev/null)" || base=""
  if [[ -z $base ]]; then
    PUSH_DIFF_FAIL_REASON="origin/${default_branch} との merge-base を解決できませんでした(未 fetch の可能性、または --cwd の解決失敗)。"
    return 1
  fi

  local patches
  # per-commit patch(--format= でメッセージを混ぜない)。merge コミットは
  # --diff-merges=first-parent で第1親との diff を出す — evil merge(どちらの
  # 親にも無い行を解決結果に足す)の追加行もここに現れる。--no-renames で
  # rename を add+delete に展開し、-U0 で無関係な文脈行を落とす。
  patches="$(git -C "$dir" log -p --diff-merges=first-parent --no-renames --unified=0 --format= "$base"..HEAD 2>/dev/null)"
  grep '^+' <<< "$patches" || true # 追加行のみ抽出。無一致(grep の非 0)は空でよい

  # 追加/rename 先のファイルパスは patch 本文に依存せず明示的に列挙する
  # (空ファイル・バイナリには +++ ヘッダ自体が出ないため、grep '^+' だけでは
  # パス名検出が漏れる)。
  git -C "$dir" log --diff-merges=first-parent --no-renames --diff-filter=A --name-only --format= "$base"..HEAD 2>/dev/null

  git -C "$dir" log --format=%B "$base"..HEAD 2>/dev/null
  return 0
}

# resolve_repo_nwo: $1(省略可)がシェルコマンド文字列なら --repo/-R 明示
# 指定を優先し、無ければ(または $1 が空なら)TARGET_CWD(--cwd。無指定なら
# 呼び出しプロセスの cwd)の origin リモートから owner/repo を導出する。
# どちらも取れなければ非 0(#10/#14 — 以前はここが常にプロセス自身の cwd
# 固定だった)。
resolve_repo_nwo() {
  local cmd="${1-}"
  if [[ -n $cmd ]] && [[ $cmd =~ (--repo|-R)[=\ ]+([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+) ]]; then
    printf '%s' "${BASH_REMATCH[2]}"
    return 0
  fi
  local url
  url="$(git -C "${TARGET_CWD:-.}" remote get-url origin 2>/dev/null)" || return 1
  url="${url%.git}"
  url="${url#git@github.com:}"
  url="${url#https://github.com/}"
  url="${url#ssh://git@github.com/}"
  [[ -n $url && $url == */* ]] || return 1
  printf '%s' "$url"
}

# repo_visibility: $1=owner/repo -> PUBLIC/PRIVATE/INTERNAL/UNKNOWN。
# TTL 付きキャッシュ(TSV: nwo, visibility, checked-at epoch)。取得に失敗したら
# UNKNOWN を返す — 呼び出し側は UNKNOWN を PUBLIC と同じ扱い(検査続行)にする
# (判定不能を「検査しない理由」にしない fail-loud の一環)。
repo_visibility() {
  local nwo="$1" now line r v t
  now="$(date +%s)"
  if [[ -f $VIS_CACHE ]]; then
    while IFS=$'\t' read -r r v t; do
      [[ $r == "$nwo" ]] || continue
      if (( now - t < CACHE_TTL )); then
        printf '%s' "$v"
        return 0
      fi
      break
    done < "$VIS_CACHE"
  fi
  local vis
  vis="$("$GH_BIN" repo view "$nwo" --json visibility --jq .visibility 2>/dev/null)" || vis=""
  [[ -n $vis ]] || { printf 'UNKNOWN'; return 0; }
  mkdir -p "$STATE_DIR"
  local tmp
  tmp="$(mktemp "$STATE_DIR/visibility-cache.tsv.XXXXXX")"
  { [[ -f $VIS_CACHE ]] && awk -F'\t' -v r="$nwo" '$1 != r' "$VIS_CACHE"
    printf '%s\t%s\t%s\n' "$nwo" "$vis" "$now"; } > "$tmp"
  mv "$tmp" "$VIS_CACHE"
  printf '%s' "$vis"
}

# ---- サブコマンド -----------------------------------------------------------

# cmd_scan: 任意のテキスト(stdin または FILE)を denylist と突き合わせる。
# MCP tool_input など、シェルコマンド文字列でない入力全般が対象。stdin/FILE
# を読めなければ ask にエスカレートする(以前は無言 exit 0 だった)。
cmd_scan() {
  local src="${1--}" text
  if [[ $src == "-" || -z $src ]]; then
    if ! text="$(cat)"; then
      emit_verdict ask "stdin を読み取れませんでした。" engine-unavailable
    fi
  else
    if ! text="$(cat "$src" 2>/dev/null)"; then
      emit_verdict ask "${src} を読み取れませんでした。" engine-unavailable
    fi
  fi
  require_orgs_file
  build_patterns
  if match_verdict "$text"; then
    emit_verdict "$VERDICT" "$(verdict_reason "$VERDICT")" "$(reason_id_for_verdict "$VERDICT")" "$MATCH_CLASS" "$MATCH_TERM"
  fi
  exit 0
}

# cmd_scan_push: cwd の git リポジトリで、これから push する差分を検査する。
# 対象リポジトリが PRIVATE/INTERNAL と判明していれば検査自体をスキップする
# (これは「検査しない」という正当な判定であり、fail-loud の対象ではない)。
# diff/log 自体が計算できない場合は ask にエスカレートする(以前は無言 exit 0)。
cmd_scan_push() {
  local nwo vis
  nwo="$(resolve_repo_nwo)" || nwo=""
  if [[ -n $nwo ]]; then
    vis="$(repo_visibility "$nwo")"
    [[ $vis == PRIVATE || $vis == INTERNAL ]] && exit 0
  fi

  local text
  if ! text="$(compute_push_diff_text)"; then
    emit_verdict ask "push 差分を検査できませんでした: ${PUSH_DIFF_FAIL_REASON}" push-diff-failed
  fi
  require_orgs_file
  build_patterns
  if match_verdict "$text"; then
    emit_verdict "$VERDICT" "$(verdict_reason "$VERDICT")" "$(reason_id_for_verdict "$VERDICT")" "$MATCH_CLASS" "$MATCH_TERM"
  fi
  exit 0
}

# ---- コマンド文字列の字句解析(#9/#14 対応、D1) ----------------------------
#
# 以前の cmd_scan_bash_command は正規表現で CMD 全体を検索していた
# (`gh[[:space:]]+(pr|issue)...` / `git[[:space:]]+push`)。これは2つの
# 問題を生んでいた:
#   1. `git -C <dir> push` / `gh --repo x pr create` のように、サブコマンド
#      の前に global option を1個挟むだけで正規表現の隣接一致が崩れ、
#      どちらの分岐にも入らず無検査 pass になる(#14 で発見)。
#   2. gh 分岐の match_verdict の照合対象が CMD 全文だったため、
#      `cd <private リポ名を含むパス> && gh pr create ...` のように
#      対象リポジトリ自身の名前がパス経由で含まれるだけで hard-deny する
#      (#9)。
#
# CMD を `;`/`&&`/`||`/`|`/改行 で区切ったセグメントに分け、セグメントごとに
# トークン位置で分類する(隣接一致ではなく位置で見る)必要があった。この
# セグメント分割・トークン化・分類・cd 積み重ねによる実効ディレクトリ解決
# (旧 split_command_segments/tokenize_segment/classify_segment/
# resolve_effective_dir)は $LEX_BIN(bleep-hook、src/lex.rs)に
# 移した — 純粋関数のみ(I/O・gh・キャッシュ非依存)で、判定を運ばない
# 継ぎ目のため、この本体の判断ロジック(match_verdict/build_patterns/
# resolve_repo_nwo)には影響しない。移植の経緯・字句解析だけを Rust に
# 委ねた理由は bleep-wise-elephant の Plan(#22 で見つかった
# fail-open の退行 — 自前実装がシェルの引用規則を不完全に近似していた)
# を参照。

# cmd_scan_bash_command: CMD の字句解析(セグメント分割・"git push" 形/
# "gh pr|issue create/edit/comment" 形の検出・cd 積み重ねによる実効
# ディレクトリ解決)は $LEX_BIN(bleep-hook、D1)に委ねる。この
# バイナリは純粋関数のみで I/O・gh を一切行わないため、判定不能を無言 pass
# にしない fail-loud の格は落ちない — 起動自体に失敗したら ask にエスカレート
# する(下記 lex_out の読み取り失敗を参照)。出力は5行の固定ヘッダ
# (found_push/push_dir/found_gh/gh_repo_override/gh_effective_dir)+
# scan_subject(jq 非依存を保つための独自の単純書式、bleep-hook
# lex --help 参照)。照合対象(scan subject)は CMD 全文から `cd <単一
# トークン>` セグメントだけを除いたもの(#9)。push/gh のどちらの形も
# 見つからなければ無検査で pass(フォールスルー)。Claude/Codex/Copilot の
# Bash 系 host が共通で呼ぶ、シェルコマンド用の唯一の判定入口。
cmd_scan_bash_command() {
  local cmd="${1-}"
  [[ -n $cmd ]] || { usage >&2; exit 2; }

  local lex_out
  if ! lex_out="$("$LEX_BIN" lex --cwd "${TARGET_CWD:-.}" -- "$cmd" 2>/dev/null)"; then
    emit_verdict ask "コマンドの字句解析に失敗しました(bleep-hook が見つからないか実行できません)。" lex-failed
  fi

  local found_push found_gh push_dir gh_repo_override gh_effective_dir scan_subject
  {
    IFS= read -r found_push
    IFS= read -r push_dir
    IFS= read -r found_gh
    IFS= read -r gh_repo_override
    IFS= read -r gh_effective_dir
    scan_subject="$(cat)"
  } <<< "$lex_out"

  if [[ $found_gh == "1" ]]; then
    local gh_nwo="$gh_repo_override"
    if [[ -z $gh_nwo ]]; then
      local saved_target="$TARGET_CWD"
      TARGET_CWD="$gh_effective_dir"
      gh_nwo="$(resolve_repo_nwo)" || gh_nwo=""
      TARGET_CWD="$saved_target"
    fi
    # 優先順位は従来どおり gh > git push(1個のコマンドに両方が含まれる
    # 稀なケースでは gh 側だけを検査する — 既存実装からの引き継ぎ)。
    if [[ -n $gh_nwo ]]; then
      local vis
      vis="$(repo_visibility "$gh_nwo")"
      [[ $vis == PRIVATE || $vis == INTERNAL ]] && exit 0
    fi
    require_orgs_file
    build_patterns
    if match_verdict "$scan_subject"; then
      emit_verdict "$VERDICT" "$(verdict_reason "$VERDICT")" "$(reason_id_for_verdict "$VERDICT")" "$MATCH_CLASS" "$MATCH_TERM"
    fi
    exit 0
  fi

  if [[ $found_push == "1" ]]; then
    TARGET_CWD="$push_dir"
    cmd_scan_push
    return
  fi

  exit 0
}

# compute_since_diff_text: $1=since_rev -> "$1..HEAD" 範囲の追加行 + 新規/
# rename 先ファイルパス + commit メッセージを出力する。抽出ロジックは
# compute_push_diff_text(bleep 内の単一正本、D7)と同じ3本の git
# 呼び出しを流用するが、default branch/merge-base の自動解決はしない —
# audit --since はユーザが明示的に起点を指定する手動操作であり、push の
# fail-loud 経路(起点を自動解決できなければ ask)とは前提が異なる。
compute_since_diff_text() {
  local since="$1" dir="${TARGET_CWD:-.}"
  local patches
  patches="$(git -C "$dir" log -p --diff-merges=first-parent --no-renames --unified=0 --format= "$since"..HEAD 2>/dev/null)"
  grep '^+' <<< "$patches" || true

  git -C "$dir" log --diff-merges=first-parent --no-renames --diff-filter=A --name-only --format= "$since"..HEAD 2>/dev/null

  git -C "$dir" log --format=%B "$since"..HEAD 2>/dev/null
  return 0
}

audit() {
  local remote=false since=''
  local -a paths=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --remote) remote=true ;;
      --since)
        since="${2-}"
        shift
        ;;
      *) paths+=("$1") ;;
    esac
    shift
  done

  build_patterns
  local hit=0 content

  # --since <rev>: working tree の現物(git ls-files)は「今 push したら
  # 何が漏れるか」しか見ない。private → public 化の直前には、既に削除
  # した内容(過去のコミットにだけ残る denylist 文字列)も含めて履歴全体を
  # 確認したい(G3)。working tree のスキャンを置き換えるのではなく追加する
  # — 両方確認できて初めて「これから公開して大丈夫か」の判断材料になる。
  # match_verdict はグローバル変数 VERDICT で結果を返す(コマンド置換で
  # 囲むと判定レッジャー用の付随変数がサブシェルに閉じてしまうため)。
  if [[ -n $since ]]; then
    local since_text
    since_text="$(compute_since_diff_text "$since")"
    if match_verdict "$since_text"; then
      printf '%s: history-since=%s\n' "$VERDICT" "$since"
      hit=1
    fi
  fi

  if ((${#paths[@]} == 0)); then
    mapfile -t paths < <(git ls-files 2>/dev/null)
  fi
  local f
  for f in "${paths[@]}"; do
    [[ -f $f ]] || continue
    path_allow_suppressed "$f" && continue
    content="$(cat "$f" 2>/dev/null)"
    if match_verdict "$content"; then
      printf '%s: file=%s\n' "$VERDICT" "$f"
      hit=1
    fi
  done

  if [[ $remote == true ]] && command -v "$GH_BIN" > /dev/null 2>&1; then
    local n title body
    while IFS=$'\t' read -r n title body; do
      [[ -n $n ]] || continue
      if match_verdict "$title"$'\n'"$body"; then
        printf '%s: issue=#%s\n' "$VERDICT" "$n"
        hit=1
      fi
    done < <("$GH_BIN" issue list --state open --limit 200 --json number,title,body \
      --jq '.[] | [.number, .title, (.body // "" | gsub("\n";" "))] | @tsv' 2> /dev/null)
    while IFS=$'\t' read -r n title body; do
      [[ -n $n ]] || continue
      if match_verdict "$title"$'\n'"$body"; then
        printf '%s: pr=#%s\n' "$VERDICT" "$n"
        hit=1
      fi
    done < <("$GH_BIN" pr list --state open --limit 200 --json number,title,body \
      --jq '.[] | [.number, .title, (.body // "" | gsub("\n";" "))] | @tsv' 2> /dev/null)
  fi

  if [[ $hit -eq 0 ]]; then
    printf '残存ヒットはありません。\n'
  fi
  return $hit
}

selftest() {
  local tmp
  tmp="$(mktemp -d)"
  TEST_TMP="$tmp"
  trap 'rm -rf "$TEST_TMP"' EXIT

  export BLEEP_CONFIG_DIR="$tmp/config"
  export BLEEP_STATE_DIR="$tmp/state"
  export BLEEP_LEDGER_DIR="$tmp/agent-verdicts"
  export BLEEP_ORGS_FILE="$tmp/config/orgs.txt"
  export BLEEP_REPOS_FILE="$tmp/config/repos.txt"
  export BLEEP_ALLOW_STOPWORDS_FILE="$tmp/config/allow-stopwords.txt"
  export BLEEP_ALLOW_REGEXES_FILE="$tmp/config/allow-regexes.txt"
  export BLEEP_ALLOW_PATHS_FILE="$tmp/config/allow-paths.txt"
  # 実ホストの ~/.config/publish-guard の有無で理由文が変わらないよう固定する
  # (このパスは作らない — 「移行未了」を見るケースだけ別パスを渡す)。
  export BLEEP_LEGACY_CONFIG_DIR="$tmp/legacy-config-absent"
  export BLEEP_OWNER="test-owner"
  init_vars # export しただけでは既に評価済みの変数に反映されないため明示的に再計算する
  mkdir -p "$tmp/config" "$tmp/state"
  printf 'acme\n' > "$BLEEP_ORGS_FILE"
  printf 'acme/secret-project\n' > "$BLEEP_REPOS_FILE"

